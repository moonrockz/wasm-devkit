///|
/// Compare retained WAT with exact pinned invocations and a prebuilt CLI.
/// Usage: test-decompiler-compatibility.mbtx WASM_TOOLS_1_262_0 WASM2WAT_1_0_42 WASM_DEVKIT
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/core/env",
}

///|
// Newlines inside string literals are data. Quotes in comments are not string
// delimiters. Do not normalize whitespace, escapes, numbers or identifiers.
fn normalize(text : String) -> String {
  let chars = text.iter().to_array()
  let out = StringBuilder()
  let mut quoted = false
  let mut escaped = false
  let mut line_comment = false
  let mut block_comment = 0
  let mut at = 0
  while at < chars.length() {
    let char = chars[at]
    let next = if at + 1 < chars.length() { Some(chars[at + 1]) } else { None }
    if quoted {
      out.write_char(char)
      if escaped {
        escaped = false
      } else if char == '\\' {
        escaped = true
      } else if char == '"' {
        quoted = false
      }
      at += 1
      continue
    }
    if !line_comment {
      if char == '(' && next == Some(';') {
        block_comment += 1
      } else if char == ';' && next == Some(')') && block_comment > 0 {
        block_comment -= 1
      } else if block_comment == 0 && char == ';' && next == Some(';') {
        line_comment = true
      } else if block_comment == 0 && char == '"' {
        quoted = true
      }
    }
    if char == '\r' && next == Some('\n') {
      out.write_char('\n')
      line_comment = false
      at += 2
    } else {
      out.write_char(char)
      if char == '\n' {
        line_comment = false
      }
      at += 1
    }
  }
  let result = out.to_string()
  if quoted {
    result
  } else {
    result.trim_end(chars="\n").to_owned() + "\n"
  }
}

///|
test "only permitted newline differences normalize" {
  assert_eq(normalize("(module)\r\n\r\n"), "(module)\n")
  assert_eq(normalize("(module)"), "(module)\n")
  assert_eq(normalize("\"a\r\nb\"\r\n"), "\"a\r\nb\"\n")
  assert_eq(normalize(";; \"\r\n(module)\r\n"), ";; \"\n(module)\n")
  assert_eq(normalize("(; \"\r\n;)\r\n(module)"), "(; \"\n;)\n(module)\n")
  assert_true(normalize("i32.const 16") != normalize("i32.const 0x10"))
  assert_true(normalize("  (module)") != normalize("(module)"))
  assert_true(normalize("\"\\0a\"") != normalize("\"\\u{a}\""))
}

///|
async fn checked(program : String, args : Array[String]) -> String {
  let (code, out, error) = @process.collect_output(program, args)
  if code != 0 {
    fail(program + ": " + error.text())
  }
  out.text()
}

///|
async fn main {
  guard @env.args()[1:] is [wasm_tools, wabt, cli] else {
    fail(
      "Usage: test-decompiler-compatibility.mbtx WASM_TOOLS_1_262_0 WASM2WAT_1_0_42 WASM_DEVKIT",
    )
  }
  let version = checked(wasm_tools, ["--version"]).trim().to_owned()
  if version != "wasm-tools 1.262.0" &&
    !version.has_prefix("wasm-tools 1.262.0 ") {
    fail("expected wasm-tools 1.262.0, got " + version)
  }
  assert_eq(checked(wabt, ["--version"]).trim(), "1.0.42")
  let root = "tests/decompiler/compatibility/"
  // One Node process checks all hashes using the repository's pinned Node.
  ignore(
    checked("node", [
      "--input-type=module", "-e", "import{createHash}from'node:crypto';import{readFileSync}from'node:fs';const root=process.argv[1];for(const line of readFileSync(root+'SHA256SUMS','utf8').trim().split('\\n')){const [digest,path]=line.split('  ');if(createHash('sha256').update(readFileSync(root+path)).digest('hex')!==digest)throw Error('fixture hash mismatch: '+path)}",
      root,
    ]),
  )
  let scratch = ".dev/decompiler-compatibility"
  @fs.mkdir(scratch, recursive=true, allow_exist=true)
  let mut count = 0
  for line in @fs.read_file(root + "cases.tsv").text().split("\n") {
    if line.is_empty() || line.has_prefix("#") {
      continue
    }
    let fields = line.split("\t").map(StringView::to_owned).to_array()
    guard fields.length() == 7 || fields.length() == 8 else {
      fail("invalid decompiler fixture row")
    }
    let name = fields[0]
    let component = fields[1] == "component"
    let accepted = fields[2] == "accepted"
    let compatibility_accepted = accepted &&
      (fields.length() == 7 || fields[7] != "rejected")
    let input = root + name + ".wasm"
    let source = @fs.read_file(input).binary()
    let default = @process.collect_output(cli, ["decompile", input])
    assert_eq(
      default.0,
      if accepted {
        0
      } else {
        1
      },
      msg=name + ": default profile",
    )
    for
      mode in (if component { ["wasm-tools"] } else { ["wasm-tools", "wabt"] }) {
      let expected_success = fields[if mode == "wasm-tools" { 3 } else { 4 }] ==
        "success"
      let (ref_code, reference, _) = @process.collect_output(
        if mode == "wasm-tools" {
          wasm_tools
        } else {
          wabt
        },
        if mode == "wasm-tools" {
          ["print", input]
        } else {
          ["--enable-all", input]
        },
      )
      assert_eq(ref_code == 0, expected_success, msg=name + ": pinned " + mode)
      let (code, actual, error) = @process.collect_output(cli, [
        "decompile", input, "--compatibility", mode,
      ])
      if !compatibility_accepted || !expected_success {
        assert_eq(code, 1, msg=name + ": reject " + mode + " " + error.text())
        assert_eq(actual.text(), "")
        continue
      }
      assert_eq(code, 0, msg=name + ": " + mode + " " + error.text())
      let expected_path = root + name + "." + mode + ".wat"
      let expected = @fs.read_file(expected_path).text()
      assert_eq(
        normalize(reference.text()),
        normalize(expected),
        msg=name + ": reference drift " + mode,
      )
      assert_eq(
        normalize(actual.text()),
        normalize(expected),
        msg=name + ": compatibility mismatch " + mode,
      )
      let readback = scratch + "/" + name + "." + mode + ".wasm"
      let (parse_code, _, _) = @process.collect_output(wasm_tools, [
        "parse", expected_path, "-o", readback,
      ])
      if fields[if mode == "wasm-tools" { 5 } else { 6 }] == "reject" {
        assert_true(
          parse_code != 0,
          msg=name + ": measured reference readback boundary",
        )
      } else {
        assert_eq(parse_code, 0, msg=name + ": reference readback " + mode)
        assert_eq(
          @fs.read_file(readback).binary(),
          @fs.read_file(root + name + "." + mode + ".reencoded.wasm").binary(),
        )
        ignore(checked(wasm_tools, ["validate", "--features", "all", readback]))
      }
      count += 1
    }
    if component {
      let (code, out, _) = @process.collect_output(cli, [
        "decompile", input, "--compatibility", "wabt",
      ])
      assert_eq(code, 1)
      assert_eq(out.text(), "")
    }
    assert_eq(@fs.read_file(input).binary(), source)
  }
  println("Pinned decompiler comparisons passed: \{count}")
}
