///|
/// Exercise the real CLI over files and redirected stdin.
/// Usage: test-cli.mbtx [wasm|native|--binary PATH|--moonx VERSION]
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/core/env",
}

///|
async fn main {
  let args = @env.args()[1:]
  let (program, prefix) = match args {
    [] =>
      ("moon", ["run", "cmd/wasm-devkit", "--target", "wasm", "--quiet", "--"])
    ["wasm"] | ["native"] =>
      ("moon", ["run", "cmd/wasm-devkit", "--target", args[0], "--quiet", "--"])
    ["--binary", path] => (path, [])
    ["--moonx", version] => ("moonx", ["moonrockz/wasm-devkit@" + version])
    _ =>
      fail("Usage: test-cli.mbtx [wasm|native|--binary PATH|--moonx VERSION]")
  }
  let dir = ".dev/cli-smoke"
  @fs.mkdir(dir, recursive=true, allow_exist=true)
  let wit = dir + "/sample.wit"
  let wac = dir + "/sample.wac"
  let invalid = dir + "/invalid.wit"
  let malformed = dir + "/malformed.wit"
  @fs.write_file(wit, "//keep\npackage a:b; interface i {type t=u8;}")
  @fs.write_file(
    wac, "package a:b; let x = new a:b { ... }; export (x).run as \"run\";",
  )
  @fs.write_file(invalid, "interface i { type t = list<; }")
  @fs.write_file(malformed, b"\xff")
  let run = async fn(
    command : Array[String],
    expected : Int32,
    input : String,
  ) -> (String, String) {
    let argv = prefix.copy()
    argv.append(command)
    let (code, out, err) = @process.collect_output(
      program,
      argv,
      stdin=@process.redirect_from_file(input),
    )
    if code != expected {
      fail(
        "CLI \{command.join(" ")}: expected \{expected}, got \{code}: \{err.text()}",
      )
    }
    (out.text(), err.text())
  }
  let (version, _) = run(["--version"], 0, wit)
  assert_true(version.has_prefix("wasm-devkit "))
  let (help, _) = run(["--help"], 0, wit)
  assert_true(help.contains("--check"))
  for file in [wit, wac] {
    let (out, err) = run(["parse", file], 0, wit)
    assert_true(out.contains(": valid "))
    assert_eq(err, "")
    for command in ["ast", "cst", "tokens", "print", "format"] {
      let (text, _) = run([command, file], 0, wit)
      assert_false(text.is_empty())
    }
  }
  let semantic_wac = dir + "/semantic.wac"
  let semantic_bad = dir + "/semantic-bad.wit"
  @fs.write_file(
    semantic_wac, "package a:b; import f: func(); let x = f; export x as \"x\";",
  )
  @fs.write_file(semantic_bad, "interface api { type t = missing; }")
  let _ = run(["verify", wit], 0, wit)
  let _ = run(["verify", semantic_wac], 0, wit)
  let ordered_wac = dir + "/ordered.wac"
  let ordered_source = "package example:app; interface api { resource r { constructor(); get: func() -> r; } type id = u32; } world base { use api.{r, id}; export run: func(x: r) -> id; } world app { include base; } import component: app;"
  @fs.write_file(ordered_wac, ordered_source)
  let _ = run(["verify", ordered_wac], 0, wit)
  let _ = run(
    ["verify", "-", "--language", "wac", "--base", dir],
    0,
    ordered_wac,
  )
  assert_eq(@fs.read_file(ordered_wac).text(), ordered_source)
  let invalid_wac = dir + "/ordered-invalid.wac"
  for
    (source, code, related) in [
      (
        "package example:app; type first = later; type later = u8;", "WAC-S005",
        false,
      ),
      (
        "package example:app; interface api {} import f: func(x: api);", "WAC-S005",
        true,
      ),
      (
        "package example:app; interface api { resource r; f: func() -> borrow<r>; }",
        "WAC-S006", false,
      ),
      (
        "package example:app; interface api { resource r { f: func(self: u8); } }",
        "WAC-S004", true,
      ),
    ] {
    @fs.write_file(invalid_wac, source)
    let _ = run(["check", invalid_wac], 0, wit)
    let (_, diagnostic) = run(["verify", invalid_wac], 1, wit)
    assert_true(diagnostic.contains(code))
    assert_true(diagnostic.contains(invalid_wac + ":1:"))
    if related {
      assert_true(diagnostic.contains("first declared here"))
    }
    assert_eq(@fs.read_file(invalid_wac).text(), source)
  }
  let _ = run(["verify", "--language", "wit", "--base", "."], 0, wit)
  let _ = run(["verify", semantic_bad], 1, wit)
  let _ = run(["check", semantic_bad], 0, wit)
  let _ = run(["verify", dir + "/missing.wit"], 2, wit)
  let _ = run(["verify", malformed], 2, wit)
  let _ = run(["verify"], 2, wit)
  let resource_api = dir + "/resources.wit"
  let resource_source = "package example:resources;interface files{resource file{constructor(path:string)->result<file,string>;read:async func()->list<u8>;open:static func(path:string)->file;position:get()->u64;position:set(value:u64);}}world app{import files;}"
  @fs.write_file(resource_api, resource_source)
  let _ = run(["verify", resource_api], 0, wit)
  let _ = run(["verify", "--language", "wit", "--base", dir], 0, resource_api)
  assert_eq(@fs.read_file(resource_api).text(), resource_source)
  let invalid_resource = dir + "/invalid-resource.wit"
  let invalid_resource_source = "package example:resources;interface files{resource file{constructor()->own<file>;}}"
  @fs.write_file(invalid_resource, invalid_resource_source)
  let _ = run(["check", invalid_resource], 0, wit)
  let (_, resource_error) = run(["verify", invalid_resource], 1, wit)
  assert_true(resource_error.contains("WIT-S007"))
  assert_true(resource_error.contains(invalid_resource + ":1:"))
  assert_eq(@fs.read_file(invalid_resource).text(), invalid_resource_source)
  let invalid_accessor = dir + "/invalid-accessor.wit"
  let invalid_accessor_source = "package example:resources;interface files{resource file{position:get()->u64;position:set(value:u64)->u8;}}"
  @fs.write_file(invalid_accessor, invalid_accessor_source)
  let _ = run(["check", invalid_accessor, "--all-features"], 0, wit)
  let (_, accessor_error) = run(["verify", invalid_accessor], 1, wit)
  assert_true(accessor_error.contains("WIT-S007"))
  assert_true(accessor_error.contains(invalid_accessor + ":1:"))
  assert_eq(@fs.read_file(invalid_accessor).text(), invalid_accessor_source)
  let gated = dir + "/gated.wit"
  let gated_source = "package example:features;interface api{@unstable(feature=foo)resource r;f:func(x:r);}"
  @fs.write_file(gated, gated_source)
  let _ = run(["check", gated], 0, wit)
  let (_, gated_error) = run(["verify", gated, "--all-features"], 1, wit)
  assert_true(gated_error.contains("WIT-S013"))
  let _ = run(["verify", gated, "--semantic-feature", "foo"], 0, wit)
  let _ = run(
    ["verify", "--language", "wit", "--base", dir, "--all-semantic-features"],
    0,
    gated,
  )
  let _ = run(["verify", gated, "--semantic-feature", "other"], 1, wit)
  let _ = run(["verify", gated, "--semantic-feature"], 2, wit)
  assert_eq(@fs.read_file(gated).text(), gated_source)
  let package_blocks = dir + "/package-blocks.wit"
  let package_blocks_source = "package example:app;world app{include example:dep/base;}package example:dep{world base{import host:interface{resource item;load:func()->item;}}}"
  @fs.write_file(package_blocks, package_blocks_source)
  let (blocks_summary, _) = run(["verify", package_blocks, "--json"], 0, wit)
  assert_true(blocks_summary.contains("example:dep/base"))
  let _ = run(["verify", package_blocks, "--world", "example:dep/base"], 0, wit)
  let _ = run(["verify", "--language", "wit", "--base", dir], 0, package_blocks)
  assert_eq(@fs.read_file(package_blocks).text(), package_blocks_source)
  let duplicate_block = dir + "/duplicate-package-block.wit"
  @fs.write_file(
    duplicate_block, "package example:app;package example:app{interface api{}}",
  )
  let _ = run(["check", duplicate_block], 0, wit)
  let (_, block_error) = run(["verify", duplicate_block], 1, wit)
  assert_true(block_error.contains("WIT-S011"))
  assert_true(block_error.contains(duplicate_block + ":1:"))
  let (stdin_wit, _) = run(["parse", "--language", "wit"], 0, wit)
  assert_true(stdin_wit.contains("<stdin>: valid wit"))
  let (stdin_wac, _) = run(["print", "-", "--language", "wac"], 0, wac)
  assert_true(stdin_wac.contains("export (x).run as \"run\";"))
  let (bad, error) = run(["parse", invalid], 1, wit)
  assert_eq(bad, "")
  assert_true(error.contains("WIT-P001"))
  assert_true(error.contains(invalid + ":1:"))
  let (bad, error) = run(["format", invalid, "--write"], 1, wit)
  assert_eq(bad, "")
  assert_false(error.is_empty())
  assert_eq(@fs.read_file(invalid).text(), "interface i { type t = list<; }")
  let _ = run(["format", wit, "--check"], 1, wit)
  let (expected, _) = run(["format", wit], 0, wit)
  let _ = run(["format", wit, "--write"], 0, wit)
  assert_eq(@fs.read_file(wit).text(), expected)
  assert_true(expected.contains("//keep"))
  let _ = run(["format", wit, "--check"], 0, wit)
  let _ = run(["parse", dir + "/missing.wit"], 2, wit)
  let _ = run(["parse", malformed], 2, wit)
  let _ = run(["parse"], 2, wit)
  let _ = run(["format", "--language", "wit", "--write"], 2, wit)
  let package_dir = dir + "/package"
  let dependency_dir = package_dir + "/deps/dep"
  @fs.mkdir(dependency_dir, recursive=true, allow_exist=true)
  let world = package_dir + "/world.wit"
  let api = dependency_dir + "/api.wit"
  let mapped = dir + "/mapped.wit"
  let world_source = "package example:app@1.0.0; world app { import example:dep/api@1.0.0; }"
  let api_source = "package example:dep@1.0.0; interface api { greet: func(name: string) -> string; }"
  @fs.write_file(world, world_source)
  @fs.write_file(api, api_source)
  @fs.write_file(mapped, api_source)
  let _ = run(["verify", package_dir, "--language", "wit"], 0, wit)
  let _ = run(["verify", world], 0, wit)
  let _ = run(["verify", "--language", "wit", "--base", package_dir], 0, world)
  let _ = run(["verify", "--language", "wit"], 2, world)
  let _ = run(["verify", world, "--dep", "wrong:package=../mapped.wit"], 1, wit)
  let _ = run(["verify", world, "--dep", "example:dep=missing.wit"], 2, wit)
  let _ = run(["verify", world, "--deps-dir", "missing"], 2, wit)
  @fs.write_file(
    api, "// 😀\npackage example:dep@1.0.0; interface api { type item = missing; }",
  )
  let (_, dependency_error) = run(["verify", world], 1, wit)
  assert_true(dependency_error.contains(api + ":2:"))
  assert_true(dependency_error.contains("required by dependency"))
  let _ = run(
    ["verify", world, "--dep", "example:dep@1.0.0=../mapped.wit"],
    0,
    wit,
  )
  assert_eq(@fs.read_file(world).text(), world_source)
  @fs.write_file(api, api_source)
  let (_, _) = run(["verify", world, "--world", "app"], 0, wit)
  let (_, _) = run(["verify", world, "--world", "missing"], 1, wit)
  let (summary, _) = run(
    ["verify", world, "--world", "example:app/app@1.0.0", "--json"],
    0,
    wit,
  )
  assert_true(summary.contains("example:dep/api@1.0.0"))
  let worlds = dir + "/worlds.wit"
  @fs.write_file(worlds, "package example:worlds;world first{}world second{}")
  let (_, _) = run(["verify", worlds, "--world", "example:worlds"], 1, wit)
  let encoded_dir = dir + "/encoded-package"
  let encoded_deps = encoded_dir + "/deps"
  @fs.mkdir(encoded_deps, recursive=true, allow_exist=true)
  let encoded_world = encoded_dir + "/world.wit"
  let encoded_binary = encoded_deps + "/dep.wasm"
  let encoded_wat = encoded_dir + "/standalone/dep.wat"
  @fs.mkdir(encoded_dir + "/standalone", recursive=true, allow_exist=true)
  // Original fixture generated by wasm-tools 1.262.0 at the semantic corpus pin.
  let encoded_bytes = b"\x00\x61\x73\x6d\x0d\x00\x01\x00\x07\x4b\x01\x41\x02\x01\x42\x06\x01\x79\x04\x00\x02\x69\x64\x03\x00\x00\x01\x72\x01\x02\x69\x64\x01\x04\x00\x04\x69\x74\x65\x6d\x03\x00\x02\x01\x40\x01\x01\x78\x03\x00\x73\x04\x00\x03\x72\x75\x6e\x01\x04\x04\x00\x15\x65\x78\x61\x6d\x70\x6c\x65\x3a\x64\x65\x70\x2f\x61\x70\x69\x40\x31\x2e\x30\x2e\x30\x05\x00\x0b\x09\x01\x00\x03\x61\x70\x69\x03\x00\x00\x07\xb0\x01\x01\x41\x02\x01\x41\x04\x01\x42\x06\x01\x79\x04\x00\x02\x69\x64\x03\x00\x00\x01\x72\x01\x02\x69\x64\x01\x04\x00\x04\x69\x74\x65\x6d\x03\x00\x02\x01\x40\x01\x01\x78\x03\x00\x73\x04\x00\x03\x72\x75\x6e\x01\x04\x03\x00\x15\x65\x78\x61\x6d\x70\x6c\x65\x3a\x64\x65\x70\x2f\x61\x70\x69\x40\x31\x2e\x30\x2e\x30\x05\x00\x01\x42\x06\x01\x79\x04\x00\x02\x69\x64\x03\x00\x00\x01\x72\x01\x02\x69\x64\x01\x04\x00\x04\x69\x74\x65\x6d\x03\x00\x02\x01\x40\x01\x01\x78\x03\x00\x73\x04\x00\x03\x72\x75\x6e\x01\x04\x04\x00\x15\x65\x78\x61\x6d\x70\x6c\x65\x3a\x64\x65\x70\x2f\x61\x70\x69\x40\x31\x2e\x30\x2e\x30\x05\x01\x04\x00\x15\x65\x78\x61\x6d\x70\x6c\x65\x3a\x64\x65\x70\x2f\x61\x70\x70\x40\x31\x2e\x30\x2e\x30\x04\x00\x0b\x09\x01\x00\x03\x61\x70\x70\x03\x02\x00\x00\x10\x0c\x70\x61\x63\x6b\x61\x67\x65\x2d\x64\x6f\x63\x73\x01\x7b\x7d\x00\x2f\x09\x70\x72\x6f\x64\x75\x63\x65\x72\x73\x01\x0c\x70\x72\x6f\x63\x65\x73\x73\x65\x64\x2d\x62\x79\x01\x0d\x77\x69\x74\x2d\x63\x6f\x6d\x70\x6f\x6e\x65\x6e\x74\x07\x30\x2e\x32\x36\x32\x2e\x30"
  @fs.write_file(encoded_binary, encoded_bytes)
  @fs.write_file(
    encoded_wat, "(component\n  (type (;0;)\n    (component\n      (type (;0;)\n        (instance\n          (type (;0;) u32)\n          (export (;1;) \"id\" (type (eq 0)))\n          (type (;2;) (record (field \"id\" 1)))\n          (export (;3;) \"item\" (type (eq 2)))\n          (type (;4;) (func (param \"x\" 3) (result string)))\n          (export (;0;) \"run\" (func (type 4)))\n        )\n      )\n      (export (;0;) \"example:dep/api@1.0.0\" (instance (type 0)))\n    )\n  )\n  (export (;1;) \"api\" (type 0))\n  (type (;2;)\n    (component\n      (type (;0;)\n        (component\n          (type (;0;)\n            (instance\n              (type (;0;) u32)\n              (export (;1;) \"id\" (type (eq 0)))\n              (type (;2;) (record (field \"id\" 1)))\n              (export (;3;) \"item\" (type (eq 2)))\n              (type (;4;) (func (param \"x\" 3) (result string)))\n              (export (;0;) \"run\" (func (type 4)))\n            )\n          )\n          (import \"example:dep/api@1.0.0\" (instance (;0;) (type 0)))\n          (type (;1;)\n            (instance\n              (type (;0;) u32)\n              (export (;1;) \"id\" (type (eq 0)))\n              (type (;2;) (record (field \"id\" 1)))\n              (export (;3;) \"item\" (type (eq 2)))\n              (type (;4;) (func (param \"x\" 3) (result string)))\n              (export (;0;) \"run\" (func (type 4)))\n            )\n          )\n          (export (;1;) \"example:dep/api@1.0.0\" (instance (type 1)))\n        )\n      )\n      (export (;0;) \"example:dep/app@1.0.0\" (component (type 0)))\n    )\n  )\n  (export (;3;) \"app\" (type 2))\n  (@custom \"package-docs\" \"\\01{}\")\n  (@producers\n    (processed-by \"wit-component\" \"0.262.0\")\n  )\n)\n",
  )
  @fs.write_file(
    encoded_world, "package example:app;world app{import example:dep/api@1.0.0;}",
  )
  let (binary_summary, _) = run(["verify", encoded_binary, "--json"], 0, wit)
  let (wat_summary, _) = run(["verify", encoded_wat, "--json"], 0, wit)
  assert_eq(binary_summary, wat_summary)
  let (encoded_summary, _) = run(["verify", encoded_world, "--json"], 0, wit)
  assert_true(encoded_summary.contains("example:dep/api@1.0.0"))
  let _ = run(
    ["verify", "--language", "wit", "--base", encoded_dir],
    0,
    encoded_world,
  )
  let _ = run(
    ["verify", encoded_world, "--dep", "example:dep=standalone/dep.wat"],
    0,
    wit,
  )
  let (_, encoded_mapping_error) = run(
    ["verify", encoded_world, "--dep", "wrong:package=deps/dep.wasm"],
    1,
    wit,
  )
  assert_true(encoded_mapping_error.contains("WIT-S011"))
  assert_true(encoded_mapping_error.contains("dep.wasm:[binary]"))
  let (_, encoded_world_error) = run(
    ["verify", encoded_binary, "--world", "missing"],
    1,
    wit,
  )
  assert_true(encoded_world_error.contains("dep.wasm:[binary]"))
  let broken_binary = encoded_dir + "/broken.wasm"
  @fs.write_file(broken_binary, b"\x00asm")
  let (_, encoded_error) = run(["verify", broken_binary], 1, wit)
  assert_true(encoded_error.contains("WIT-B001"))
  let _ = run(["verify", encoded_dir + "/missing.wasm"], 2, wit)
  assert_eq(@fs.read_file(encoded_binary).binary(), encoded_bytes)
  let source_with_binary_suffix = encoded_dir + "/source.wasm"
  @fs.mkdir(source_with_binary_suffix, recursive=true, allow_exist=true)
  @fs.write_file(
    source_with_binary_suffix + "/api.wit",
    "package example:source;interface api{}",
  )
  let _ = run(["verify", source_with_binary_suffix], 0, wit)
  let (alias_binary, _) = run(
    ["verify", "tests/semantic/wit-encoded-alias-renamed.wasm", "--json"],
    0,
    wit,
  )
  let (alias_wat, _) = run(
    ["verify", "tests/semantic/wit-encoded-alias-renamed.wat", "--json"],
    0,
    wit,
  )
  assert_eq(alias_binary, alias_wat)
  let alias_root = dir + "/alias-root.wit"
  @fs.write_file(
    alias_root, "package example:consumer;world app{import example:aliases/api@1.0.0;}",
  )
  let (alias_closure, _) = run(
    [
      "verify", alias_root, "--base", ".", "--dep", "example:aliases=tests/semantic/wit-encoded-alias-local.wasm",
      "--json",
    ],
    0,
    wit,
  )
  assert_true(alias_closure.contains("example:aliases/base@1.0.0"))
  assert_true(alias_closure.contains("example:aliases/api@1.0.0"))
  let (foreign_binary, _) = run(
    ["verify", "tests/semantic/wit-encoded-foreign-unioned.wasm", "--json"],
    0,
    wit,
  )
  let (foreign_wat, _) = run(
    ["verify", "tests/semantic/wit-encoded-foreign-unioned.wat", "--json"],
    0,
    wit,
  )
  assert_eq(foreign_binary, foreign_wat)
  assert_true(foreign_binary.contains("example:dep/base@2.0.0"))
  let _ = run(
    [
      "verify", "tests/semantic/wit-encoded-foreign-closure-complete.wit", "--language",
      "wit", "--json",
    ],
    0,
    wit,
  )
  let (_, foreign_merge_error) = run(
    [
      "verify", "tests/semantic/wit-encoded-foreign-closure-bad-result.wit", "--language",
      "wit",
    ],
    1,
    wit,
  )
  assert_true(foreign_merge_error.contains("WIT-B004"))
  let foreign_source = dir + "/foreign-base.wit"
  @fs.write_file(
    foreign_source, "package example:dep@2.0.0;interface base{resource r;}",
  )
  let (foreign_mixed, _) = run(
    [
      "verify",
      "tests/semantic/wit-encoded-foreign-unioned.wasm",
      "--base",
      ".",
      "--dep",
      "example:dep=" + foreign_source,
      "--json",
    ],
    0,
    wit,
  )
  assert_eq(foreign_mixed, foreign_binary)
  for fixture in ["functions", "methods"] {
    let path = "tests/semantic/wit-encoded-selected-" + fixture + ".wit"
    let _ = run(["verify", path, "--json"], 0, wit)
    let _ = run(["verify", path, "--semantic-feature", "other"], 0, wit)
    let (_, selected_error) = run(
      ["verify", path, "--semantic-feature", "hidden"],
      1,
      wit,
    )
    assert_true(selected_error.contains("WIT-B004"))
    let _ = run(["verify", path, "--all-semantic-features"], 1, wit)
  }
  let (world_resources, _) = run(
    ["verify", "tests/semantic/wit-encoded-world-rich.wasm", "--json"],
    0,
    wit,
  )
  let (world_resource_wat, _) = run(
    ["verify", "tests/semantic/wit-encoded-world-rich.wat", "--json"],
    0,
    wit,
  )
  assert_eq(world_resources, world_resource_wat)
  assert_true(world_resources.contains("[constructor]r"))
  assert_true(world_resources.contains("[method]r.f"))
  let (world_metadata, _) = run(
    ["verify", "tests/semantic/wit-encoded-world-metadata.wasm", "--json"],
    0,
    wit,
  )
  let (world_metadata_all, _) = run(
    [
      "verify", "tests/semantic/wit-encoded-world-metadata.wasm", "--all-semantic-features",
      "--json",
    ],
    0,
    wit,
  )
  assert_eq(world_metadata, world_metadata_all)
  for name in ["foreign-use-chain", "implements", "maps", "wasi-http"] {
    let path = "tests/semantic/wit-encoded-upstream/" + name
