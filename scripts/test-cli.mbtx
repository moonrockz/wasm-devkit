///|
/// Exercise the real CLI over files and redirected stdin.
/// Usage: test-cli.mbtx [wasm|native|--binary PATH|--moonx VERSION]
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/core/env",
}

///|
async fn main {
  let args = @env.args()[1:]
  let (program, prefix) = match args {
    [] =>
      ("moon", ["run", "cmd/wasm-devkit", "--target", "wasm", "--quiet", "--"])
    ["wasm"] | ["native"] =>
      ("moon", ["run", "cmd/wasm-devkit", "--target", args[0], "--quiet", "--"])
    ["--binary", path] => (path, [])
    ["--moonx", version] => ("moonx", ["moonrockz/wasm-devkit@" + version])
    _ =>
      fail("Usage: test-cli.mbtx [wasm|native|--binary PATH|--moonx VERSION]")
  }
  let dir = ".dev/cli-smoke"
  @fs.mkdir(dir, recursive=true, allow_exist=true)
  let wit = dir + "/sample.wit"
  let wac = dir + "/sample.wac"
  let invalid = dir + "/invalid.wit"
  let malformed = dir + "/malformed.wit"
  @fs.write_file(wit, "//keep\npackage a:b; interface i {type t=u8;}")
  @fs.write_file(
    wac, "package a:b; let x = new a:b { ... }; export (x).run as \"run\";",
  )
  @fs.write_file(invalid, "interface i { type t = list<; }")
  @fs.write_file(malformed, b"\xff")
  let run = async fn(
    command : Array[String],
    expected : Int32,
    input : String,
  ) -> (String, String) {
    let argv = prefix.copy()
    argv.append(command)
    let (code, out, err) = @process.collect_output(
      program,
      argv,
      stdin=@process.redirect_from_file(input),
    )
    if code != expected {
      fail(
        "CLI \{command.join(" ")}: expected \{expected}, got \{code}: \{err.text()}",
      )
    }
    (out.text(), err.text())
  }
  let (version, _) = run(["--version"], 0, wit)
  assert_true(version.has_prefix("wasm-devkit "))
  let (help, _) = run(["--help"], 0, wit)
  assert_true(help.contains("--check"))
  for file in [wit, wac] {
    let (out, err) = run(["parse", file], 0, wit)
    assert_true(out.contains(": valid "))
    assert_eq(err, "")
    for command in ["ast", "cst", "tokens", "print", "format"] {
      let (text, _) = run([command, file], 0, wit)
      assert_false(text.is_empty())
    }
  }
  let semantic_wac = dir + "/semantic.wac"
  let semantic_bad = dir + "/semantic-bad.wit"
  @fs.write_file(
    semantic_wac, "package a:b; import f: func(); let x = f; export x as \"x\";",
  )
  @fs.write_file(semantic_bad, "interface api { type t = missing; }")
  let _ = run(["verify", wit], 0, wit)
  let _ = run(["verify", semantic_wac], 0, wit)
  let _ = run(["verify", "--language", "wit", "--base", "."], 0, wit)
  let _ = run(["verify", semantic_bad], 1, wit)
  let _ = run(["check", semantic_bad], 0, wit)
  let _ = run(["verify", dir + "/missing.wit"], 2, wit)
  let _ = run(["verify", malformed], 2, wit)
  let _ = run(["verify"], 2, wit)
  let resource_api = dir + "/resources.wit"
  let resource_source = "package example:resources;interface files{resource file{constructor(path:string)->result<file,string>;read:async func()->list<u8>;open:static func(path:string)->file;}}world app{import files;}"
  @fs.write_file(resource_api, resource_source)
  let _ = run(["verify", resource_api], 0, wit)
  let _ = run(["verify", "--language", "wit", "--base", dir], 0, resource_api)
  assert_eq(@fs.read_file(resource_api).text(), resource_source)
  let invalid_resource = dir + "/invalid-resource.wit"
  let invalid_resource_source = "package example:resources;interface files{resource file{constructor()->own<file>;}}"
  @fs.write_file(invalid_resource, invalid_resource_source)
  let _ = run(["check", invalid_resource], 0, wit)
  let (_, resource_error) = run(["verify", invalid_resource], 1, wit)
  assert_true(resource_error.contains("WIT-S007"))
  assert_true(resource_error.contains(invalid_resource + ":1:"))
  assert_eq(@fs.read_file(invalid_resource).text(), invalid_resource_source)
  let (stdin_wit, _) = run(["parse", "--language", "wit"], 0, wit)
  assert_true(stdin_wit.contains("<stdin>: valid wit"))
  let (stdin_wac, _) = run(["print", "-", "--language", "wac"], 0, wac)
  assert_true(stdin_wac.contains("export (x).run as \"run\";"))
  let (bad, error) = run(["parse", invalid], 1, wit)
  assert_eq(bad, "")
  assert_true(error.contains("WIT-P001"))
  assert_true(error.contains(invalid + ":1:"))
  let (bad, error) = run(["format", invalid, "--write"], 1, wit)
  assert_eq(bad, "")
  assert_false(error.is_empty())
  assert_eq(@fs.read_file(invalid).text(), "interface i { type t = list<; }")
  let _ = run(["format", wit, "--check"], 1, wit)
  let (expected, _) = run(["format", wit], 0, wit)
  let _ = run(["format", wit, "--write"], 0, wit)
  assert_eq(@fs.read_file(wit).text(), expected)
  assert_true(expected.contains("//keep"))
  let _ = run(["format", wit, "--check"], 0, wit)
  let _ = run(["parse", dir + "/missing.wit"], 2, wit)
  let _ = run(["parse", malformed], 2, wit)
  let _ = run(["parse"], 2, wit)
  let _ = run(["format", "--language", "wit", "--write"], 2, wit)
  let package_dir = dir + "/package"
  let dependency_dir = package_dir + "/deps/dep"
  @fs.mkdir(dependency_dir, recursive=true, allow_exist=true)
  let world = package_dir + "/world.wit"
  let api = dependency_dir + "/api.wit"
  let mapped = dir + "/mapped.wit"
  let world_source = "package example:app@1.0.0; world app { import example:dep/api@1.0.0; }"
  let api_source = "package example:dep@1.0.0; interface api { greet: func(name: string) -> string; }"
  @fs.write_file(world, world_source)
  @fs.write_file(api, api_source)
  @fs.write_file(mapped, api_source)
  let _ = run(["verify", package_dir, "--language", "wit"], 0, wit)
  let _ = run(["verify", world], 0, wit)
  let _ = run(["verify", "--language", "wit", "--base", package_dir], 0, world)
  let _ = run(["verify", "--language", "wit"], 2, world)
  let _ = run(["verify", world, "--dep", "wrong:package=../mapped.wit"], 1, wit)
  let _ = run(["verify", world, "--dep", "example:dep=missing.wit"], 2, wit)
  let _ = run(["verify", world, "--deps-dir", "missing"], 2, wit)
  @fs.write_file(
    api, "// 😀\npackage example:dep@1.0.0; interface api { type item = missing; }",
  )
  let (_, dependency_error) = run(["verify", world], 1, wit)
  assert_true(dependency_error.contains(api + ":2:"))
  assert_true(dependency_error.contains("required by dependency"))
  let _ = run(
    ["verify", world, "--dep", "example:dep@1.0.0=../mapped.wit"],
    0,
    wit,
  )
  assert_eq(@fs.read_file(world).text(), world_source)
  @fs.write_file(api, api_source)
  let (_, _) = run(["verify", world, "--world", "app"], 0, wit)
  let (_, _) = run(["verify", world, "--world", "missing"], 1, wit)
  let (summary, _) = run(
    ["verify", world, "--world", "example:app/app@1.0.0", "--json"],
    0,
    wit,
  )
  assert_true(summary.contains("example:dep/api@1.0.0"))
  let worlds = dir + "/worlds.wit"
  @fs.write_file(worlds, "package example:worlds;world first{}world second{}")
  let (_, _) = run(["verify", worlds, "--world", "example:worlds"], 1, wit)
  println("CLI smoke checks passed")
}
