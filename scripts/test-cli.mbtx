      "tests/semantic/wit-encoded-metadata-sequence-function-empty.wasm",
    ).binary(),
  )
  let (_, sequence_error) = run(["verify", metadata_sequence], 1, wit)
  assert_true(sequence_error.contains("WIT-B004"))
  let wit_provider_dir = dir + "/wac-wit-provider"
  let wit_provider = wit_provider_dir + "/deps/lookup/types"
  @fs.mkdir(wit_provider + "/deps/base", recursive=true, allow_exist=true)
  let wit_composition = wit_provider_dir + "/root.wac"
  let wit_source = "package embedded:types; interface api {use embedded:base/types.{handle};take:func(h:handle);} world app {import api;}"
  @fs.write_file(wit_provider + "/root.wit", wit_source)
  @fs.write_file(
    wit_provider + "/deps/base/types.wit",
    "package embedded:base; interface types {resource handle;}",
  )
  @fs.write_file(
    wit_composition, "package test:app; import i: lookup:types/api; export i;",
  )
  let _ = run(["verify", wit_composition], 0, wit)
  let _ = run(
    ["verify", "-", "--language", "wac", "--base", wit_provider_dir],
    0,
    wit_composition,
  )
  let (_, explicit_directory) = run(
    ["verify", wit_composition, "--dep", "lookup:types=deps/lookup/types"],
    2,
    wit,
  )
  assert_true(explicit_directory.contains("must be a file"))
  // A single-file override does not discover a sibling deps directory.
  let (_, single_missing) = run(
    [
      "verify", wit_composition, "--dep", "lookup:types=deps/lookup/types/root.wit",
    ],
    1,
    wit,
  )
  assert_true(single_missing.contains("root.wit:["))
  assert_true(single_missing.contains("requested here"))
  @fs.write_file(
    wit_provider_dir + "/single.wit",
    "package embedded:single; interface api {f:func();} world app {import f: func();export out:func();}",
  )
  let _ = run(
    ["verify", wit_composition, "--dep", "lookup:types=single.wit"],
    0,
    wit,
  )
  @fs.write_file(
    wit_composition, "package test:app;let i=new lookup:types {};export i.api;",
  )
  let _ = run(
    ["verify", wit_composition, "--dep", "lookup:types=single.wit"],
    0,
    wit,
  )
  @fs.write_file(
    wit_composition, "package test:app targets lookup:types/app;import f: func();export f as out;",
  )
  let _ = run(
    ["verify", wit_composition, "--dep", "lookup:types=single.wit"],
    0,
    wit,
  )
  @fs.write_file(
    wit_composition, "package test:app targets lookup:types/app;import f: func(x: u32);export f as out;",
  )
  let (_, wit_target) = run(
    ["verify", wit_composition, "--dep", "lookup:types=single.wit"],
    1,
    wit,
  )
  assert_true(wit_target.contains("WAC-T003"))
  assert_true(wit_target.contains("single.wit:["))
  assert_eq(@fs.read_file(wit_provider + "/root.wit").text(), wit_source)
  let mixed_provider = wit_provider_dir + "/mixed/lookup/types"
  @fs.mkdir(mixed_provider + "/deps", recursive=true, allow_exist=true)
  @fs.write_file(
    mixed_provider + "/root.wit",
    "package example:types; interface api {use example:dep/types@1.2.3.{handle};take: func(h: handle);} world app {import api;export api;}",
  )
  @fs.write_file(
    mixed_provider + "/deps/dep.wasm",
    b"\x00\x61\x73\x6d\x0d\x00\x01\x00\x07\x2d\x01\x41\x02\x01\x42\x01\x04\x00\x06\x68\x61\x6e\x64\x6c\x65\x03\x01\x04\x00\x17\x65\x78\x61\x6d\x70\x6c\x65\x3a\x64\x65\x70\x2f\x74\x79\x70\x65\x73\x40\x31\x2e\x32\x2e\x33\x05\x00\x0b\x0b\x01\x00\x05\x74\x79\x70\x65\x73\x03\x00\x00\x00\x10\x0c\x70\x61\x63\x6b\x61\x67\x65\x2d\x64\x6f\x63\x73\x01\x7b\x7d\x00\x2f\x09\x70\x72\x6f\x64\x75\x63\x65\x72\x73\x01\x0c\x70\x72\x6f\x63\x65\x73\x73\x65\x64\x2d\x62\x79\x01\x0d\x77\x69\x74\x2d\x63\x6f\x6d\x70\x6f\x6e\x65\x6e\x74\x07\x30\x2e\x32\x35\x38\x2e\x30",
  )
  @fs.write_file(
    wit_composition, "package test:app; import i: lookup:types/api; export i;",
  )
  let _ = run(["verify", wit_composition, "--deps-dir", "mixed"], 0, wit)
  let invalid_deps = wit_provider_dir + "/invalid-deps/lookup/types"
  @fs.mkdir(invalid_deps, recursive=true, allow_exist=true)
  @fs.write_file(
    invalid_deps + "/root.wit",
    "package example:types;interface api {f:func();}",
  )
  @fs.write_file(invalid_deps + "/deps", "not a directory")
  let (_, invalid_deps_error) = run(
    ["verify", wit_composition, "--deps-dir", "invalid-deps"],
    2,
    wit,
  )
  assert_true(invalid_deps_error.contains("WAC-P006"))
  for extension in ["wasm", "wat"] {
    for
      (name, status) in [("function", 0), ("memory", 0), ("wrong-function", 1)] {
      let root = "tests/semantic/wac-runtime-modules/composition/" + name
      let (_, diagnostic) = run(
        [
          "verify",
          root + "/input.wac",
          "--dep",
          "test:actual=actual." + extension,
          "--dep",
          "test:expected=expected." + extension,
        ],
        status,
        wit,
      )
      if status == 1 {
        assert_true(diagnostic.contains("WAC-C005"))
      }
    }
  }
  for extension in ["wasm", "wat"] {
    for
      (name, status) in [
        ("memory-narrow", 0),
        ("memory-wide", 1),
        ("function-equal", 0),
        ("tag-equal", 0),
      ] {
      let root = "tests/semantic/wac-core-modules/composition/" + name
      let (_, diagnostic) = run(
        [
          "verify",
          root + "/input.wac",
          "--dep",
          "test:actual=actual." + extension,
          "--dep",
          "test:expected=expected." + extension,
        ],
        status,
        wit,
      )
      if status == 1 {
        assert_true(diagnostic.contains("WAC-C005"))
      }
    }
    let (_, diagnostic) = run(
      [
        "verify",
        "tests/semantic/wac-core-modules/fill/memory-narrow/input.wac",
        "--dep",
        "test:a=a." + extension,
        "--dep",
        "test:b=b." + extension,
      ],
      1,
      wit,
    )
    assert_true(diagnostic.contains("WAC-C005"))
  }
  for extension in ["wasm", "wat"] {
    for
      (name, status) in [
        ("scalar", 0),
        ("string", 0),
        ("resource-own", 0),
        ("wrong-realloc", 1),
      ] {
      let root = "tests/semantic/wac-canonical-functions/composition/" + name
      let (_, diagnostic) = run(
        [
          "verify",
          root + "/input.wac",
          "--dep",
          "test:canonical=dep." + extension,
        ],
        status,
        wit,
      )
      if status == 1 {
        assert_true(diagnostic.contains("WAC-B003"))
      }
    }
  }
  for extension in ["wasm", "wat"] {
    for
      (name, status, code) in [
        ("task.cancel", 0, ""),
        ("stream.new", 0, ""),
        ("gc-lift-many", 0, ""),
        ("gc-lower-scalars", 0, ""),
        ("gc-lower-mismatch", 1, "WAC-B003"),
        ("task-return-unsupported", 1, "WAC-B002"),
      ] {
      let root = "tests/semantic/wac-canonical-intrinsics/composition/" + name
      let (_, diagnostic) = run(
        [
          "verify",
          root + "/input.wac",
          "--dep",
          "test:intrinsics=dep." + extension,
        ],
        status,
        wit,
      )
      if status == 1 {
        assert_true(diagnostic.contains(code))
      }
    }
  }
  for extension in ["wasm", "wat"] {
    for
      (name, status) in [
        ("async-callback", 0),
        ("component-start", 0),
        ("async-sync-type", 1),
      ] {
      let root = "tests/semantic/wac-proposal-profiles/composition/" + name
      let (_, diagnostic) = run(
        ["verify", root + "/input.wac", "--dep", "test:async=dep." + extension],
        status,
        wit,
      )
      if status == 1 {
        assert_true(diagnostic.contains("WAC-B003"))
      }
    }
  }
  for extension in ["wasm", "wat"] {
    for
      (name, status) in [
        ("new-alias", 0),
        ("destructor-i64-i64", 0),
        ("destructor-i64-i32", 1),
      ] {
      let root = "tests/semantic/wac-resource-intrinsics/composition/" + name
      let (_, diagnostic) = run(
        [
          "verify",
          root + "/input.wac",
          "--dep",
          "test:resource=dep." + extension,
        ],
        status,
        wit,
      )
      if status == 1 {
        assert_true(diagnostic.contains("WAC-B003"))
      }
    }
  }
  for extension in ["wasm", "wat"] {
    for
      (name, status) in [
        ("function", 0),
        ("resource-fresh", 0),
        ("resource-fresh-wrong-use", 1),
      ] {
      let root = "tests/semantic/wac-runtime-instances/composition/" + name
      let (_, diagnostic) = run(
        [
          "verify",
          root + "/input.wac",
          "--dep",
          "test:runtime=dep." + extension,
        ],
        status,
        wit,
      )
      if status == 1 {
        assert_true(diagnostic.contains("WAC-B003"))
      }
    }
  }
  for name in ["hello", "greeter"] {
    let root = "tests/semantic/wac-core-control/production/" + name
    let (binary, _) = run(
      ["verify", root + "/input.wac", "--dep", "test:dep=dep.wasm"],
      0,
      wit,
    )
    let (text, _) = run(
      ["verify", root + "/input.wac", "--dep", "test:dep=dep.wat"],
      0,
      wit,
    )
    assert_eq(binary, text)
  }
  for extension in ["wasm", "wat"] {
    for
      (name, status) in [
        ("named-export", 0),
        ("instance-alias", 0),
        ("anonymous-private", 0),
        ("anonymous-export", 1),
      ] {
      let root = "tests/semantic/wac-runtime-origins/composition/" + name
      let (_, diagnostic) = run(
        [
          "verify",
          root + "/input.wac",
          "--dep",
          "test:runtime=dep." + extension,
        ],
        status,
        wit,
      )
      if status == 1 {
        assert_true(diagnostic.contains("WAC-B003"))
      }
    }
  }
  for extension in ["wasm", "wat"] {
    for
      (name, status) in [
        ("inline", 0),
        ("argument", 0),
        ("resource-substitution", 0),
        ("anonymous-value", 1),
        ("argument-twice", 1),
      ] {
      let root = "tests/semantic/wac-runtime-values/composition/" + name
      let (_, diagnostic) = run(
        [
          "verify",
          root + "/input.wac",
          "--dep",
          "test:runtime=dep." + extension,
        ],
        status,
        wit,
      )
      if status == 1 {
        assert_true(diagnostic.contains("WAC-B003"))
      }
    }
  }
  for extension in ["wasm", "wat"] {
    for
      (name, status) in [
        ("fill", 0),
        ("forward", 0),
        ("duplicate-export", 1),
        ("unused-access", 1),
      ] {
      let root = "tests/semantic/wac-value-externs/composition/" + name
      let (_, diagnostic) = run(
        ["verify", root + "/input.wac", "--dep", "test:dep=dep." + extension],
        status,
        wit,
      )
      if status == 1 {
        assert_true(diagnostic.contains("WAC-C010"))
      }
    }
  }
  for extension in ["wasm", "wat"] {
    for
      (name, status) in [
        ("http-0.2.0", 0),
        ("http-0.2.3", 0),
        ("matched-nested-local-resource", 0),
        ("crossed-nested-local-resource", 1),
      ] {
      let root = "tests/semantic/wac-nested-components/composition/" + name
      let (_, diagnostic) = run(
        ["verify", root + "/input.wac", "--dep", "test:nested=dep." + extension],
        status,
        wit,
      )
      if status == 1 {
        assert_true(diagnostic.contains("WAC-B003"))
      }
    }
  }
  // Copyable reader-facing bundles run through every installed/source CLI path.
  let bundle = "examples/verification/"
  for
    command in [
      ["verify", bundle + "wit", "--language", "wit", "--world", "app"],
      [
        "verify",
        bundle + "wit/app.wit",
        "--dep",
        "example:files@1.0.0=deps/files",
      ],
      ["verify", bundle + "wac/app.wac"],
      [
        "verify",
        bundle + "wac/implicit.wac",
        "--dep",
        "example:relay=deps/example/relay.wat",
      ],
    ] {
    run(command, 0, wit) |> ignore
  }
  for
    (language, path, base) in [
      ("wit", bundle + "wit/app.wit", bundle + "wit"),
      ("wac", bundle + "wac/app.wac", bundle + "wac"),
    ] {
    let before = @fs.read_file(path).text()
    run(["verify", "-", "--language", language, "--base", base], 0, path)
    |> ignore
    assert_eq(@fs.read_file(path).text(), before)
  }
  let (_, invalid_resource) = run(
    ["verify", bundle + "invalid.wit", "--deps-dir", "wit/deps"],
    1,
    wit,
  )
  assert_true(invalid_resource.contains("invalid.wit:6:9: error WIT-S007"))
  let (_, invalid_wiring) = run(["verify", bundle + "wac/invalid.wac"], 1, wit)
  assert_true(invalid_wiring.contains("invalid.wac:4:33: error WAC-C005"))
  assert_true(
    invalid_wiring.contains(
      "deps/example/relay.wat:[binary]: expected type declared here",
    ),
  )
  let (_, invalid_target) = run(
    ["verify", bundle + "wac/target-invalid.wac"],
    1,
    wit,
  )
  assert_true(invalid_target.contains("WAC-T002"))
  assert_true(invalid_target.contains("deps/example/types/api.wit"))
  println("CLI smoke checks passed")
}
