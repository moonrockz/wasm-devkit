///|
/// Exercise the real CLI over files and redirected stdin.
/// Usage: test-cli.mbtx [wasm|native|--binary PATH|--moonx VERSION]
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/core/env",
}

///|
async fn main {
  let args = @env.args()[1:]
  let (program, prefix) = match args {
    [] =>
      ("moon", ["run", "cmd/wasm-devkit", "--target", "wasm", "--quiet", "--"])
    ["wasm"] | ["native"] =>
      ("moon", ["run", "cmd/wasm-devkit", "--target", args[0], "--quiet", "--"])
    ["--binary", path] => (path, [])
    ["--moonx", version] => ("moonx", ["moonrockz/wasm-devkit@" + version])
    _ =>
      fail("Usage: test-cli.mbtx [wasm|native|--binary PATH|--moonx VERSION]")
  }
  let dir = ".dev/cli-smoke"
  @fs.mkdir(dir, recursive=true, allow_exist=true)
  let wit = dir + "/sample.wit"
  let wac = dir + "/sample.wac"
  let invalid = dir + "/invalid.wit"
  let malformed = dir + "/malformed.wit"
  @fs.write_file(wit, "//keep\npackage a:b; interface i {type t=u8;}")
  @fs.write_file(
    wac, "package a:b; let x = new a:b { ... }; export (x).run as \"run\";",
  )
  @fs.write_file(invalid, "interface i { type t = list<; }")
  @fs.write_file(malformed, b"\xff")
  let run = async fn(
    command : Array[String],
    expected : Int32,
    input : String,
  ) -> (String, String) {
    let argv = prefix.copy()
    argv.append(command)
    let (code, out, err) = @process.collect_output(
      program,
      argv,
      stdin=@process.redirect_from_file(input),
    )
    if code != expected {
      fail(
        "CLI \{command.join(" ")}: expected \{expected}, got \{code}: \{err.text()}",
      )
    }
    (out.text(), err.text())
  }
  let (version, _) = run(["--version"], 0, wit)
  assert_true(version.has_prefix("wasm-devkit "))
  let (help, _) = run(["--help"], 0, wit)
  assert_true(help.contains("--check"))
  for file in [wit, wac] {
    let (out, err) = run(["parse", file], 0, wit)
    assert_true(out.contains(": valid "))
    assert_eq(err, "")
    for command in ["ast", "cst", "tokens", "print", "format"] {
      let (text, _) = run([command, file], 0, wit)
      assert_false(text.is_empty())
    }
  }
  let semantic_wac = dir + "/semantic.wac"
  let semantic_bad = dir + "/semantic-bad.wit"
  @fs.write_file(
    semantic_wac, "package a:b; import f: func(); let x = f; export x as \"x\";",
  )
  @fs.write_file(semantic_bad, "interface api { type t = missing; }")
  let _ = run(["verify", wit], 0, wit)
  let _ = run(["verify", semantic_wac], 0, wit)
  let ordered_wac = dir + "/ordered.wac"
  let ordered_source = "package example:app; interface api { resource r { constructor(); get: func() -> r; } type id = u32; } world base { use api.{r, id}; export run: func(x: r) -> id; } world app { include base; } import component: app;"
  @fs.write_file(ordered_wac, ordered_source)
  let _ = run(["verify", ordered_wac], 0, wit)
  let _ = run(
    ["verify", "-", "--language", "wac", "--base", dir],
    0,
    ordered_wac,
  )
  assert_eq(@fs.read_file(ordered_wac).text(), ordered_source)

  // Original component package fixture: encoded:original@2.0.0 with api/service.
  // Same bytes/model oracle as verifier/packages_test.mbt; lookup key is separate.
  let package_bytes = b"\x00\x61\x73\x6d\x0d\x00\x01\x00\x07\x52\x01\x41\x02\x01\x42\x06\x04\x00\x06\x68\x61\x6e\x64\x6c\x65\x03\x01\x01\x79\x04\x00\x06\x6e\x75\x6d\x62\x65\x72\x03\x00\x01\x01\x68\x00\x01\x40\x01\x01\x68\x03\x00\x02\x04\x00\x04\x74\x61\x6b\x65\x01\x04\x04\x00\x1a\x65\x6e\x63\x6f\x64\x65\x64\x3a\x6f\x72\x69\x67\x69\x6e\x61\x6c\x2f\x61\x70\x69\x40\x32\x2e\x30\x2e\x30\x05\x00\x0b\x09\x01\x00\x03\x61\x70\x69\x03\x00\x00\x07\x88\x01\x01\x41\x02\x01\x41\x04\x01\x42\x06\x04\x00\x06\x68\x61\x6e\x64\x6c\x65\x03\x01\x01\x79\x04\x00\x06\x6e\x75\x6d\x62\x65\x72\x03\x00\x01\x01\x68\x00\x01\x40\x01\x01\x68\x03\x00\x02\x04\x00\x04\x74\x61\x6b\x65\x01\x04\x03\x00\x1a\x65\x6e\x63\x6f\x64\x65\x64\x3a\x6f\x72\x69\x67\x69\x6e\x61\x6c\x2f\x61\x70\x69\x40\x32\x2e\x30\x2e\x30\x05\x00\x01\x40\x00\x00\x79\x04\x00\x06\x61\x6e\x73\x77\x65\x72\x01\x01\x04\x00\x1e\x65\x6e\x63\x6f\x64\x65\x64\x3a\x6f\x72\x69\x67\x69\x6e\x61\x6c\x2f\x73\x65\x72\x76\x69\x63\x65\x40\x32\x2e\x30\x2e\x30\x04\x00\x0b\x0d\x01\x00\x07\x73\x65\x72\x76\x69\x63\x65\x03\x02\x00\x00\x10\x0c\x70\x61\x63\x6b\x61\x67\x65\x2d\x64\x6f\x63\x73\x01\x7b\x7d\x00\x2f\x09\x70\x72\x6f\x64\x75\x63\x65\x72\x73\x01\x0c\x70\x72\x6f\x63\x65\x73\x73\x65\x64\x2d\x62\x79\x01\x0d\x77\x69\x74\x2d\x63\x6f\x6d\x70\x6f\x6e\x65\x6e\x74\x07\x30\x2e\x32\x36\x32\x2e\x30"
  let access_wac = dir + "/access.wac"
  @fs.write_file(
    access_wac, "package test:app; interface api {run: func();} import service: api; let run = (service).run; export run;",
  )
  let _ = run(["verify", access_wac], 0, wit)
  @fs.write_file(
    access_wac, "package test:app; interface api {run: func();} import service: api; export service.missing;",
  )
  let (_, missing_access) = run(["verify", access_wac], 1, wit)
  assert_true(missing_access.contains("WAC-C002"))
  assert_true(missing_access.contains("instance type defined here"))
  @fs.write_file(
    access_wac, "package test:app; import run: func(); export run.missing;",
  )
  let (_, invalid_access) = run(["verify", access_wac], 1, wit)
  assert_true(invalid_access.contains("WAC-C001"))
  // Two original declarative components re-export a checked function argument.
  // Both local WAT loading and the composition graph run inside the CLI.
  let wiring_dir = dir + "/wiring"
  @fs.mkdir(wiring_dir + "/deps/test", recursive=true, allow_exist=true)
  let wiring = wiring_dir + "/root.wac"
  let relay = "(component (type (func (param \"x\" u32) (result u32))) (import \"f\" (func (type 0))) (export \"out\" (func 0)))"
  @fs.write_file(wiring_dir + "/deps/test/first.wat", relay)
  @fs.write_file(wiring_dir + "/deps/test/second.wat", relay)
  let wired = "package test:app; import f: func(x: u32) -> u32; let first = new test:first {f}; let second = new test:second {f: first.out}; export second.out;"
  @fs.write_file(wiring, wired)
  let _ = run(["verify", wiring], 0, wit)
  let _ = run(
    ["verify", "-", "--language", "wac", "--base", wiring_dir],
    0,
    wiring,
  )
  assert_eq(@fs.read_file(wiring).text(), wired)
  @fs.write_file(
    wiring, "package test:app; import f: func(x: u16) -> u32; let i = new test:first {f};",
  )
  let (_, signature_error) = run(["verify", wiring], 1, wit)
  assert_true(signature_error.contains("WAC-C005"))
  assert_true(signature_error.contains("first.wat:[binary]"))
  assert_true(signature_error.contains("expected type declared here"))
  @fs.write_file(
    wiring, "package test:app; import f: func(x: u32) -> u32; let i = new test:first {f}; export i.missing;",
  )
  let (_, output_error) = run(["verify", wiring], 1, wit)
  assert_true(output_error.contains("WAC-C002"))
  @fs.write_file(wiring, "package test:app; let i = new test:first {};")
  let (_, missing_argument) = run(["verify", wiring], 1, wit)
  assert_true(missing_argument.contains("WAC-C004"))
  @fs.write_file(
    wiring, "package test:app; interface api {f: func(x: u32) -> u32;} import all: api; let i = new test:first {...all}; export i.out;",
  )
  let _ = run(["verify", wiring], 0, wit)
  @fs.write_file(
    wiring, "package test:app; import f: func(x: u32) -> u32; let i = new test:first {...f};",
  )
  let (_, wrong_spread) = run(["verify", wiring], 1, wit)
  assert_true(wrong_spread.contains("WAC-C007"))
  @fs.write_file(
    wiring, "package test:app; interface api {f: func(x: u32) -> u32;} import all: api; let f = all.f; let i = new test:first {...all, f};",
  )
  let (_, empty_spread) = run(["verify", wiring], 1, wit)
  assert_true(empty_spread.contains("WAC-C007"))
  @fs.write_file(
    wiring, "package test:app; import f: func(x: u32) -> u32; export new test:first {f}...;",
  )
  let _ = run(["verify", wiring], 0, wit)
  @fs.write_file(
    wiring, "package test:app; import i: interface {f: func();}; export i.f; export i...;",
  )
  let (_, repeated_export) = run(["verify", wiring], 1, wit)
  assert_true(repeated_export.contains("WAC-C007"))
  @fs.write_file(wiring, "package test:app; import f: func(); export f...;")
  let (_, wrong_export) = run(["verify", wiring], 1, wit)
  assert_true(wrong_export.contains("WAC-C007"))
  let target_header = "package test:app targets test:app/w; world w {import f: func(x: u32) -> u32;export out: func(x: u32) -> u32;} "
  @fs.write_file(
    wiring,
    target_header +
    "import f: func(x: u32) -> u32;export new test:first {f}...;",
  )
  let _ = run(["verify", wiring], 0, wit)
  @fs.write_file(wiring, target_header + "import f: func(x: u32) -> u32;")
  let (_, missing_target_export) = run(["verify", wiring], 1, wit)
  assert_true(missing_target_export.contains("WAC-T002"))
  assert_true(missing_target_export.contains("target world declared here"))
  let unconstrained = "package test:app; world w {} import f: func();export f;"
  @fs.write_file(wiring, unconstrained)
  let _ = run(["verify", wiring], 0, wit)
  @fs.write_file(
    wiring, "package test:app targets test:app/w; world w {} import f: func();export f;",
  )
  let (_, disallowed_target_import) = run(["verify", wiring], 1, wit)
  assert_true(disallowed_target_import.contains("WAC-T001"))
  @fs.write_file(
    wiring,
    target_header + "import f: func(x: u16) -> u32;export f as out;",
  )
  let (_, incompatible_target) = run(["verify", wiring], 1, wit)
  assert_true(incompatible_target.contains("WAC-T003"))
  assert_true(incompatible_target.contains("target selected here"))
  @fs.write_file(
    wiring_dir + "/deps/test/target.wat",
    "(component (type $world (component (import \"f\" (func)) (export \"out\" (func)))) (type $wrapper (component (alias outer 1 $world (type $world)) (export \"test:target/w\" (component (type $world))))) (export \"w\" (type $wrapper)))",
  )
  @fs.write_file(
    wiring, "package test:app targets test:target/w;import f: func();export f as out;",
  )
  let _ = run(["verify", wiring], 0, wit)
  @fs.write_file(
    wiring, "package test:app targets test:target/w;import f: func(x: u32);export f as out;",
  )
  let (_, binary_target) = run(["verify", wiring], 1, wit)
  assert_true(binary_target.contains("WAC-T003"))
  assert_true(binary_target.contains("target.wat:[binary]"))
  @fs.write_file(
    wiring, "package test:app; let first = new test:first {...}; let second = new test:second {f: first.out, ...}; export second.out;",
  )
  let _ = run(["verify", wiring], 0, wit)
  @fs.write_file(
    wiring, "package test:app; let first = new test:first {...}; import f: func(x: u32) -> u32;",
  )
  let (_, fill_conflict) = run(["verify", wiring], 1, wit)
  assert_true(fill_conflict.contains("WAC-C008"))
  let package_dir = dir + "/wac-packages"
  @fs.mkdir(package_dir + "/deps/lookup/dep", recursive=true, allow_exist=true)
  let package_source = package_dir + "/root.wac"
  let package_text = "package test:app; import i: lookup:dep/api; export i;"
  @fs.write_file(package_source, package_text)
  @fs.write_file(package_dir + "/deps/lookup/dep.wasm", package_bytes)
  @fs.write_file(package_dir + "/deps/lookup/dep/1.2.3.wasm", package_bytes)
  // Use a separate name for the unversioned file: the versioned package directory
  // wins over a sibling .wasm under the reference filesystem precedence.
  @fs.write_file(package_dir + "/component.bin", package_bytes)
  let _ = run(
    ["verify", package_source, "--dep", "lookup:dep=component.bin"],
    0,
    wit,
  )
  let _ = run(
    [
      "verify", "-", "--language", "wac", "--base", package_dir, "--dep", "lookup:dep=component.bin",
    ],
    0,
    package_source,
  )
  @fs.mkdir(
    package_dir + "/binary-deps/lookup",
    recursive=true,
    allow_exist=true,
  )
  if @fs.exists(package_dir + "/binary-deps/lookup/dep.wat") {
    @fs.remove(package_dir + "/binary-deps/lookup/dep.wat")
  }
  @fs.write_file(package_dir + "/binary-deps/lookup/dep.wasm", package_bytes)
  let _ = run(["verify", package_source, "--deps-dir", "binary-deps"], 0, wit)
  @fs.write_file(
    package_source, "package test:app; import i: lookup:dep/api@1.2.3; export i;",
  )
  let _ = run(
    ["verify", package_source, "--dep", "lookup:dep=missing.bin"],
    0,
    wit,
  )
  @fs.write_file(package_source, package_text)
  let (_, missing_mapping) = run(
    ["verify", package_source, "--dep", "lookup:dep=missing.bin"],
    2,
    wit,
  )
  assert_true(missing_mapping.contains("WAC-P003"))
  let (_, missing_package) = run(
    ["verify", package_source, "--deps-dir", "absent"],
    1,
    wit,
  )
  assert_true(missing_package.contains("root.wac:1:"))
  assert_true(missing_package.contains("WAC-P003"))
  let (_, directory_package) = run(["verify", package_source], 1, wit)
  assert_true(directory_package.contains("WIT-S"))
  @fs.write_file(package_dir + "/bad.bin", b"bad")
  let (_, bad_package) = run(
    ["verify", package_source, "--dep", "lookup:dep=bad.bin"],
    1,
    wit,
  )
  assert_true(bad_package.contains("WAC-B001"))
  assert_true(bad_package.contains("bad.bin:[byte"))
  assert_true(bad_package.contains("root.wac:["))
  assert_true(bad_package.contains("requested here"))
  // Duplicate CLI mappings follow the reference override map: the last wins.
  let _ = run(
    [
      "verify", package_source, "--dep", "lookup:dep=bad.bin", "--dep", "lookup:dep=component.bin",
    ],
    0,
    wit,
  )
  @fs.write_file(package_dir + "/text.wat", "(component)")
  let (_, text_package) = run(
    ["verify", package_source, "--dep", "lookup:dep=text.wat"],
    1,
    wit,
  )
  assert_true(text_package.contains("WAC-P004"))
  @fs.write_file(
    package_dir + "/text.wat",
    "(component\n  (type (;0;)\n    (component\n      (type (;0;)\n        (instance\n          (export (;0;) \"handle\" (type (sub resource)))\n          (type (;1;) u32)\n          (export (;2;) \"number\" (type (eq 1)))\n          (type (;3;) (borrow 0))\n          (type (;4;) (func (param \"h\" 3) (result 2)))\n          (export (;0;) \"take\" (func (type 4)))\n        )\n      )\n      (export (;0;) \"encoded:original/api@2.0.0\" (instance (type 0)))\n    )\n  )\n  (export (;1;) \"api\" (type 0))\n  (type (;2;)\n    (component\n      (type (;0;)\n        (component\n          (type (;0;)\n            (instance\n              (export (;0;) \"handle\" (type (sub resource)))\n              (type (;1;) u32)\n              (export (;2;) \"number\" (type (eq 1)))\n              (type (;3;) (borrow 0))\n              (type (;4;) (func (param \"h\" 3) (result 2)))\n              (export (;0;) \"take\" (func (type 4)))\n            )\n          )\n          (import \"encoded:original/api@2.0.0\" (instance (;0;) (type 0)))\n          (type (;1;) (func (result u32)))\n          (export (;0;) \"answer\" (func (type 1)))\n        )\n      )\n      (export (;0;) \"encoded:original/service@2.0.0\" (component (type 0)))\n    )\n  )\n  (export (;3;) \"service\" (type 2))\n  (@custom \"package-docs\" \"\\01{}\")\n  (@producers\n    (processed-by \"wit-component\" \"0.262.0\")\n  )\n)\n",
  )
  let _ = run(
    ["verify", package_source, "--dep", "lookup:dep=text.wat"],
    0,
    wit,
  )
  @fs.write_file(
    package_dir + "/binary-deps/lookup/dep.wat",
    "(component\n  (type (;0;)\n    (component\n      (type (;0;)\n        (instance\n          (export (;0;) \"handle\" (type (sub resource)))\n          (type (;1;) u32)\n          (export (;2;) \"number\" (type (eq 1)))\n          (type (;3;) (borrow 0))\n          (type (;4;) (func (param \"h\" 3) (result 2)))\n          (export (;0;) \"take\" (func (type 4)))\n        )\n      )\n      (export (;0;) \"encoded:original/api@2.0.0\" (instance (type 0)))\n    )\n  )\n  (export (;1;) \"api\" (type 0))\n  (type (;2;)\n    (component\n      (type (;0;)\n        (component\n          (type (;0;)\n            (instance\n              (export (;0;) \"handle\" (type (sub resource)))\n              (type (;1;) u32)\n              (export (;2;) \"number\" (type (eq 1)))\n              (type (;3;) (borrow 0))\n              (type (;4;) (func (param \"h\" 3) (result 2)))\n              (export (;0;) \"take\" (func (type 4)))\n            )\n          )\n          (import \"encoded:original/api@2.0.0\" (instance (;0;) (type 0)))\n          (type (;1;) (func (result u32)))\n          (export (;0;) \"answer\" (func (type 1)))\n        )\n      )\n      (export (;0;) \"encoded:original/service@2.0.0\" (component (type 0)))\n    )\n  )\n  (export (;3;) \"service\" (type 2))\n  (@custom \"package-docs\" \"\\01{}\")\n  (@producers\n    (processed-by \"wit-component\" \"0.262.0\")\n  )\n)\n",
  )
  let _ = run(["verify", package_source, "--deps-dir", "binary-deps"], 0, wit)
  @fs.write_file(package_dir + "/invalid.wat", "(component binary \"bad\")")
  let (_, invalid_text) = run(
    ["verify", package_source, "--dep", "lookup:dep=invalid.wat"],
    1,
    wit,
  )
  assert_true(invalid_text.contains("invalid.wat:[binary]"))
  assert_false(invalid_text.contains("[byte "))
  assert_true(invalid_text.contains("requested here"))
  @fs.write_file(package_dir + "/binary-deps/lookup/dep.wat", package_bytes)
  let _ = run(["verify", package_source, "--deps-dir", "binary-deps"], 0, wit)
  @fs.write_file(package_dir + "/binary-deps/lookup/dep.wat", b"\x00asm")
  let (_, preferred_wat) = run(
    ["verify", package_source, "--deps-dir", "binary-deps"],
    1,
    wit,
  )
  assert_true(preferred_wat.contains("dep.wat"))
  assert_true(preferred_wat.contains("WAC-B001"))
  @fs.write_file(package_source, "package test:app;")
  let _ = run(
    ["verify", package_source, "--dep", "lookup:dep=missing.bin"],
    0,
    wit,
  )

  let invalid_wac = dir + "/ordered-invalid.wac"
  for
    (source, code, related) in [
      (
        "package example:app; type first = later; type later = u8;", "WAC-S005",
        false,
      ),
      (
        "package example:app; interface api {} import f: func(x: api);", "WAC-S005",
        true,
      ),
      (
        "package example:app; interface api { resource r; f: func() -> borrow<r>; }",
        "WAC-S006", false,
      ),
      (
        "package example:app; interface api { resource r { f: func(self: u8); } }",
        "WAC-S004", true,
      ),
    ] {
    @fs.write_file(invalid_wac, source)
    let _ = run(["check", invalid_wac], 0, wit)
    let (_, diagnostic) = run(["verify", invalid_wac], 1, wit)
    assert_true(diagnostic.contains(code))
    assert_true(diagnostic.contains(invalid_wac + ":1:"))
    if related {
      assert_true(diagnostic.contains("first declared here"))
    }
    assert_eq(@fs.read_file(invalid_wac).text(), source)
  }
  let _ = run(["verify", "--language", "wit", "--base", "."], 0, wit)
  let _ = run(["verify", semantic_bad], 1, wit)
  let _ = run(["check", semantic_bad], 0, wit)
  let _ = run(["verify", dir + "/missing.wit"], 2, wit)
  let _ = run(["verify", malformed], 2, wit)
  let _ = run(["verify"], 2, wit)
  let resource_api = dir + "/resources.wit"
  let resource_source = "package example:resources;interface files{resource file{constructor(path:string)->result<file,string>;read:async func()->list<u8>;open:static func(path:string)->file;position:get()->u64;position:set(value:u64);}}world app{import files;}"
  @fs.write_file(resource_api, resource_source)
  let _ = run(["verify", resource_api], 0, wit)
  let _ = run(["verify", "--language", "wit", "--base", dir], 0, resource_api)
  assert_eq(@fs.read_file(resource_api).text(), resource_source)
  let invalid_resource = dir + "/invalid-resource.wit"
  let invalid_resource_source = "package example:resources;interface files{resource file{constructor()->own<file>;}}"
  @fs.write_file(invalid_resource, invalid_resource_source)
  let _ = run(["check", invalid_resource], 0, wit)
  let (_, resource_error) = run(["verify", invalid_resource], 1, wit)
  assert_true(resource_error.contains("WIT-S007"))
  assert_true(resource_error.contains(invalid_resource + ":1:"))
