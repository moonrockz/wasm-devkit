///|
/// Library and CLI release preparation, validation, notes and GitHub publication.
/// No command publishes packages implicitly; the workflow controls publication.
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.5/sys",
}

///|
fn fail_with(message : String) -> Unit {
  eprintln(message)
  @sys.exit(1)
}

///|
async fn output(cmd : String, args : Array[String]) -> String {
  let (code, out, err) = @process.collect_output(cmd, args)
  if code != 0 {
    fail_with("\{cmd} failed: \{err.text()}\{out.text()}")
  }
  out.text().trim().to_owned()
}

///|
fn valid_version(value : String) -> Bool {
  let parts = value.split(".").map(p => p.to_owned()).collect()
  if parts.length() != 3 {
    return false
  }
  parts.all(part => {
    !part.is_empty() &&
    (part.length() == 1 || !part.has_prefix("0")) &&
    part.iter().all(c => c >= '0' && c <= '9')
  })
}

///|
fn module_version(text : String) -> String? {
  for line in text.split("\n") {
    if line.has_prefix("version = \"") {
      let rest = line[11:]
      if rest.find("\"") is Some(end) {
        return Some(rest[:end].to_owned())
      }
    }
  }
  None
}

///|
async fn current_version() -> String {
  match module_version(@fs.read_file("moon.mod").text()) {
    Some(value) => value
    None => {
      fail_with("root moon.mod has no version")
      ""
    }
  }
}

///|
fn section(text : String, version : String) -> String? {
  let lines = []
  let mut inside = false
  for line in text.split("\n") {
    if line.has_prefix("## [") {
      if inside {
        break
      }
      inside = line.has_prefix("## [\{version}]")
      continue
    }
    if inside {
      lines.push(line.to_owned())
    }
  }
  if inside {
    Some(lines.join("\n").trim().to_owned())
  } else {
    None
  }
}

///|
fn finished_notes(body : String) -> Bool {
  !body.trim().is_empty() && !body.contains("<!-- Highlights:")
}

///|
async fn validate(requested : String?) -> String {
  let version = current_version()
  if !valid_version(version) || version == "0.0.0" {
    fail_with(
      "A release needs a nonzero X.Y.Z version; 0.0.0 is the unpublished scaffold.",
    )
  }
  if requested is Some(value) && value != version {
    fail_with(
      "Requested version \{value} differs from root version \{version}.",
    )
  }
  output("moonx", ["scripts/versions.mbtx", "check", version]) |> ignore
  guard section(@fs.read_file("CHANGELOG.md").text(), version) is Some(body) else {
    fail_with("CHANGELOG.md has no section for \{version}.")
    return ""
  }
  if !finished_notes(body) {
    fail_with(
      "Replace the highlights placeholder and write release notes before releasing.",
    )
  }
  version
}

///|
async fn notes(version : String) -> String {
  validate(Some(version)) |> ignore
  let body = section(@fs.read_file("CHANGELOG.md").text(), version).unwrap()
  "# wasm-devkit v\{version}\n\n" +
  body +
  "\n\nInstall:\n\n- `moon add moonrockz/wit@\{version}`\n- `moon add moonrockz/wac@\{version}`\n- `moonx moonrockz/wasm-devkit@\{version} --help`\n- `mise use github:moonrockz/wasm-devkit@\{version}`\n"
}

///|
async fn prepare(version : String) -> Unit {
  if !valid_version(version) || version == "0.0.0" {
    fail_with("Expected a nonzero X.Y.Z version.")
  }
  if output("git", ["status", "--porcelain"]) != "" {
    fail_with("release:prepare requires a clean working tree.")
  }
  if output("git", ["branch", "--show-current"]) != "main" {
    fail_with("release:prepare requires main.")
  }
  output("git", ["fetch", "--tags", "origin"]) |> ignore
  if output("git", ["rev-parse", "HEAD"]) !=
    output("git", ["rev-parse", "origin/main"]) {
    fail_with("Update main to origin/main before preparing a release.")
  }
  let existing = output("git", ["tag", "--list", "v\{version}"])
  if existing != "" || version == current_version() {
    fail_with("Choose a new version; \{version} is already present.")
  }
  output("git", ["switch", "-c", "release/v\{version}"]) |> ignore
  output("moonx", ["scripts/versions.mbtx", "set", version]) |> ignore
  output("git-cliff", [
    "--unreleased",
    "--tag",
    "v\{version}",
    "--prepend",
    "CHANGELOG.md",
  ])
  |> ignore
  println(
    "Prepared release/v\{version} locally. Replace the highlights, run all checks, then commit and open a PR.",
  )
}

///|
fn release_assets(version : String) -> Array[String] {
  let result = []
  for platform in ["linux-x64", "macos-arm64", "windows-x64"] {
    let archive = "wasm-devkit-v" + version + "-" + platform + ".tar.gz"
    result.push(archive)
    result.push(archive + ".sha256")
  }
  result
}

///|
async fn github(version : String) -> Unit {
  let text = notes(version)
  let assets = release_assets(version)
  for name in assets {
    if !@fs.exists("dist/" + name) {
      fail_with("Missing validated release asset: " + name)
    }
  }
  let sha = output("git", ["rev-parse", "HEAD"])
  let tag = "v\{version}"
  let remote = output("git", [
    "ls-remote",
    "--tags",
    "origin",
    "refs/tags/\{tag}",
  ])
  if remote != "" {
    output("git", ["fetch", "origin", "tag", tag]) |> ignore
    let tagged = output("git", ["rev-parse", "\{tag}^{commit}"])
    if tagged != sha {
      fail_with("\{tag} already points to a different commit.")
    }
  }
  @fs.mkdir(".dev/out", recursive=true, allow_exist=true)
  let path = ".dev/out/release-notes.txt"
  @fs.write_file(path, text)
  let (code, _, err) = @process.collect_output("gh", [
    "api",
    "repos/moonrockz/wasm-devkit/releases/tags/\{tag}",
    "--jq",
    ".draft",
  ])
  if code == 0 {
    output("gh", ["release", "edit", tag, "--draft=false", "--notes-file", path])
    |> ignore
  } else if err.text().contains("404") {
    output("gh", [
      "release", "create", tag, "--target", sha, "--title", tag, "--notes-file",
      path,
    ])
    |> ignore
  } else {
    fail_with("Cannot inspect GitHub release: \{err.text()}")
  }
  let existing = output("gh", [
      "release", "view", tag, "--json", "assets", "--jq", ".assets[].name",
    ])
    .split("\n")
    .map(s => s.to_owned())
    .to_array()
  for name in assets {
    if !existing.contains(name) {
      // Never replace an existing asset when retrying a partial release.
      output("gh", ["release", "upload", tag, "dist/" + name]) |> ignore
    }
  }
}

///|
async fn status() -> Unit {
  let version = current_version()
  if version == "0.0.0" {
    println("info: 0.0.0 is the unpublished scaffold; no release is expected.")
    return
  }
  validate(Some(version)) |> ignore
  output("gh", [
    "release",
    "view",
    "v\{version}",
    "--json",
    "url,isDraft,targetCommitish",
  ])
  |> println
  for name in ["moonrockz/wit", "moonrockz/wac", "moonrockz/wasm-devkit"] {
    let text = output("curl", [
      "--fail",
      "--silent",
      "--show-error",
      "https://mooncakes.io/api/v0/modules/\{name}",
    ])
    let value = @json.parse(text)
    // Registry metadata lists historical versions as objects under versions.
    guard value is { "versions": versions, .. } else {
      fail_with("Unexpected registry response for \{name}.")
      return
    }
    guard versions is Array(items) else {
      fail_with("Registry versions for \{name} are not an array.")
      return
    }
    if !items.any(item => item is { "version": String(v), .. } && v == version) {
      fail_with("\{name}@\{version} is missing from mooncakes.io.")
    }
    println("ok: \{name}@\{version} is published")
  }
}

///|
async fn main {
  match @env.args()[1:] {
    ["version"] => println(output("git-cliff", ["--bumped-version"]))
    ["prepare", version] => prepare(version)
    ["validate"] => validate(None) |> println
    ["validate", version] => validate(Some(version)) |> println
    ["notes", version] => println(notes(version))
    ["github", version] => github(version)
    ["status"] => status()
    _ =>
      fail_with(
        "Usage: release.mbtx version | prepare X.Y.Z | validate [X.Y.Z] | notes X.Y.Z | github X.Y.Z | status",
      )
  }
}

///|
test "release notes require the requested section and completed highlights" {
  let text = "## [0.1.0] - today\n\nA usable parser.\n\n## [0.0.1]\n\nOlder."
  assert_eq(section(text, "0.1.0"), Some("A usable parser."))
  assert_eq(section(text, "0.2.0"), None)
  assert_false(finished_notes("<!-- Highlights: replace -->\nChanges."))
  assert_false(finished_notes(" \n "))
  assert_true(finished_notes("A usable parser."))
}

///|
test "release versions reject malformed and noncanonical inputs" {
  for
    value in [
      "", "1", "1.2", "1.2.3.4", "01.2.3", "1.2.3-rc", "v1.2.3", "1.a.3",
    ] {
    assert_false(valid_version(value))
  }
  assert_true(valid_version("0.0.1"))
  assert_true(valid_version("12.34.56"))
}

///|
test "release assets cover every supported native installation platform" {
  let names = release_assets("0.1.0")
  assert_eq(names.length(), 6)
  assert_true(names.contains("wasm-devkit-v0.1.0-linux-x64.tar.gz"))
  assert_true(names.contains("wasm-devkit-v0.1.0-macos-arm64.tar.gz.sha256"))
  assert_true(names.contains("wasm-devkit-v0.1.0-windows-x64.tar.gz"))
}
