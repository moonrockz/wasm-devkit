///|
/// Build the test-only pinned upstream API oracle, outside all published modules.
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/async@0.22.5/stdio",
  "moonbitlang/core/env",
  "moonbitlang/x@0.5.5/sys",
}

///|
async fn main {
  let version = @env.get_env_var("SEMANTIC_REFERENCE_RUST_VERSION").unwrap_or(
    "1.94.1",
  )
  let code = @process.run(
    "mise",
    [
      "exec",
      "rust@" + version,
      "--",
      "cargo",
      "build",
      "--locked",
      "--release",
      "--manifest-path",
      "tools/semantic-reference/Cargo.toml",
      "--target-dir",
      ".dev/reference-target",
    ],
    stdout=@stdio.stdout,
    stderr=@stdio.stderr,
  )
  if code != 0 {
    @sys.exit(if code > 0 { code } else { 1 })
  }
}
