x30"
  let bytes = metadata_input(
    base,
    @utf8.encode(
      "{\"interfaces\":{\"files\":{\"types\":{\"file\":{\"stability\":{\"stable\":{\"since\":\"9.0.0\"}}}},\"funcs\":{\"[method]file.read\":{\"stability\":{\"stable\":{\"since\":\"9.0.0\"}}},\"[method][get]file.position\":{\"stability\":{\"unstable\":{\"feature\":\"getter\"}}}}}}}",
    ),
  )
  let input = @verifier.decode_package(bytes).unwrap()
  let model = @verifier.resolve_packages(Encoded(input)).unwrap()
  let file = model
    .types()
    .filter(ty => ty.name == Some("file") && ty.kind is Resource)[0]
  assert_eq(file.stability, Stable("9.0.0", None))
  let read = model
    .functions()
    .filter(function => function.name == "[method]file.read")[0]
  assert_eq(read.stability, Stable("9.0.0", None))
  let receiver = model.types().filter(ty => ty.id == read.params[0].ty)[0]
  assert_eq(receiver.kind, Borrow(file.id))
  assert_eq(receiver.stability, Unknown)
  assert_true(
    !model
    .functions()
    .any(function => function.name == "[method][get]file.position"),
  )
  assert_true(
    model
    .functions()
    .any(function => function.name == "[method][set]file.position"),
  )
}

///|
test "law: arbitrary package metadata bytes fail deterministically without panics or leaked lowering" {
  @quickcheck.check(
    (data : Array[Byte]) => {
      let bytes = metadata_input(encoded_fixture(), Bytes::from_array(data))
      match @verifier.decode_package(bytes, source_id="random.wasm") {
        Ok(input) =>
          input.bytes() == bytes &&
          @verifier.resolve_packages(Encoded(input)) is Ok(model) &&
          model.sources().is_empty()
        Err(errors) =>
          @verifier.decode_package(bytes, source_id="random.wasm") is Err(again) &&
          errors == again &&
          errors.all(error => {
            error.primary.location.position == BinaryOffset(None)
          })
      }
    },
    count=200,
    max_size=256,
    seed=262016,
  )
}

///|
test "raw binary feature strings can be selected exactly through the library" {
  let text = "{\"interfaces\":{\"api\":{\"funcs\":{\"run\":{\"stability\":{\"unstable\":{\"feature\":\"\"}}}}}}}"
  assert_eq(metadata_model(text).functions().length(), 0)
  assert_eq(
    metadata_model(text, features={ enabled: [""], all_enabled: false, })
    .functions()
    .length(),
    1,
  )
}
