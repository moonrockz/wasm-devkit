  assert_eq(import_item.stability, Unstable("inline", None))
  assert_eq(export_item.stability, Stable("9.0.0", None))
  guard import_item.kind is Interface(imported) else {
    fail("missing inline import")
  }
  let imported = model
    .interfaces()
    .filter(interface_info => interface_info.id == imported)[0]
  assert_eq(imported.functions.length(), 0)
  assert_eq(imported.types.length(), 1)
  let host = world.exports.filter(item => item.name == "host")[0]
  assert_eq(host.stability, Stable("3.0.0", None))
  guard host.kind is Interface(host_id) else { fail("missing inline export") }
  let host = model
    .interfaces()
    .filter(interface_info => interface_info.id == host_id)[0]
  assert_eq(host.stability, Stable("2.0.0", None))
  assert_eq(host.functions.length(), 0)
  assert_eq(
    model.functions().filter(function => function.name == "run").length(),
    2,
  )
  assert_true(
    model
    .functions()
    .any(function => {
      function.name == "run" &&
      function.stability == Unstable("world-function", None)
    }),
  )
  assert_eq(
    model.functions().filter(function => function.name == "out")[0].stability,
    Stable("2.0.0", None),
  )
  let all = @verifier.resolve_packages(
    Encoded(input),
    semantic_features=@verifier.SemanticFeatures::all(),
  ).unwrap()
  assert_eq(
    all.interfaces().filter(interface_info => interface_info.id == imported.id)[0].functions.length(),
    1,
  )
}

///|
test "source dependencies use retained binary types without reapplying their feature gates" {
  let data = @utf8.encode(
    "{\"interfaces\":{\"api\":{\"stability\":{\"unstable\":{\"feature\":\"api\"}},\"types\":{\"id\":{\"stability\":{\"unstable\":{\"feature\":\"type\"}}}},\"funcs\":{\"run\":{\"stability\":{\"unstable\":{\"feature\":\"run\"}}}}}},\"worlds\":{\"app\":{\"stability\":{\"unstable\":{\"feature\":\"world\"}}}}}",
  )
  let binary = @verifier.decode_package(
    metadata_input(encoded_fixture(), data),
    source_id="dep.wasm",
  ).unwrap()
  let source = "// 😀\npackage example:app;interface api{use example:dep/api@1.0.0.{id};type ids=list<id>;f:func(x:ids);}world app{include example:dep/app@1.0.0;}"
  let document = section_document("app.wit", source)
  let model = @verifier.resolve_packages(Source({ documents: [document], }), dependencies=[
    Encoded(binary),
  ]).unwrap()
  assert_eq(model.sources().length(), 1)
  assert_eq(model.sources()[0].text, source)
  assert_eq(
    model
    .interfaces()
    .filter(interface_info => interface_info.package_identity.name == "dep")[0].functions.length(),
    0,
  )
  assert_true(
    model
    .types()
    .any(ty => {
      ty.location.source == "dep.wasm" &&
      ty.name == Some("id") &&
      ty.stability == Unstable("type", None)
    }),
  )
  assert_true(
    model
    .types()
    .filter(ty => ty.location.source == "app.wit")
    .all(ty => ty.stability is Unknown),
  )
  assert_eq(model.worlds()[0].imports.length(), 1)
}

