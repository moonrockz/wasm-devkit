///|
fn metadata_input(base : Bytes, data : Bytes, version~ : Byte = 1) -> Bytes {
  let out = base[0:8].to_array()
  let mut position = 8
  // Fixtures are valid components; retain type/export sections and replace customs.
  while position < base.length() {
    let start = position
    let id = base[position]
    position += 1
    let mut length = 0
    let mut shift = 0
    while true {
      let byte = base[position].to_int()
      position += 1
      length = length | ((byte & 127) << shift)
      if byte < 128 {
        break
      }
      shift += 7
    }
    position += length
    if id != 0 {
      out.append(base[start:position].to_array())
    }
  }
  let payload = [b'\x0c']
  payload.append(b"package-docs".to_array())
  payload.push(version)
  payload.append(data.to_array())
  out.push(0)
  let mut length = payload.length()
  while length >= 128 {
    out.push(((length & 127) | 128).to_byte())
    length = length >> 7
  }
  out.push(length.to_byte())
  out.append(payload)
  Bytes::from_array(out)
}

///|
fn metadata_model(
  text : String,
  features~ : @verifier.SemanticFeatures = @verifier.SemanticFeatures::default(),
) -> @verifier.Resolution {
  let input = @verifier.decode_package(
    metadata_input(encoded_fixture(), @utf8.encode(text)),
    source_id="metadata.wasm",
  ).unwrap()
  @verifier.resolve_packages(Encoded(input), semantic_features=features).unwrap()
}

///|
test "binary metadata keeps type interface and world gates while selecting interface functions" {
  let text = "{\"interfaces\":{\"api\":{\"stability\":{\"unstable\":{\"feature\":\"iface\"}},\"types\":{\"id\":{\"stability\":{\"unstable\":{\"feature\":\"types\"}}},\"item\":{\"stability\":{\"stable\":{\"since\":\"9.0.0\",\"deprecated\":\"0.1.0\"}}}},\"funcs\":{\"run\":{\"stability\":{\"unstable\":{\"feature\":\"fn flag\"}}}}}},\"worlds\":{\"app\":{\"stability\":{\"unstable\":{\"feature\":\"world\"}},\"interface_import_stability\":{\"example:dep/api@1.0.0\":{\"unstable\":{\"feature\":\"import\"}}},\"interface_export_stability\":{\"example:dep/api@1.0.0\":{\"stable\":{\"since\":\"9.0.0\"}}}}}}"
  for
    features in [
      @verifier.SemanticFeatures::default(),
      { enabled: ["fn flag"], all_enabled: false, },
      @verifier.SemanticFeatures::all(),
    ] {
    let model = metadata_model(text, features~)
    let api = model.interfaces()[0]
    assert_eq(api.stability, Unstable("iface", None))
    assert_eq(
      api.functions.length(),
      if features.all_enabled || features.enabled.contains("fn flag") {
        1
      } else {
        0
      },
    )
    assert_eq(
      model.types().filter(ty => ty.name == Some("id"))[0].stability,
      Unstable("types", None),
    )
    assert_eq(
      model.types().filter(ty => ty.name == Some("item"))[0].stability,
      Stable("9.0.0", Some("0.1.0")),
    )
    assert_true(
      model
      .types()
      .filter(ty => ty.name is None)
      .all(ty => ty.stability is Unknown),
    )
    let world = model.worlds()[0]
    assert_eq(world.stability, Unstable("world", None))
    assert_eq(world.imports.length(), 1)
    assert_eq(world.exports.length(), 1)
    assert_eq(world.imports[0].stability, Unstable("import", None))
    assert_eq(world.exports[0].stability, Stable("9.0.0", None))
    assert_true(
      model.types().all(ty => ty.location.position == BinaryOffset(None)),
    )
  }
}

///|
test "binary metadata accepts docs aggregate members both versions and strict missing targets" {
  let text = "{\"docs\":\"package docs 😀\",\"interfaces\":{\"api\":{\"docs\":\"API docs\",\"types\":{\"item\":{\"items\":{\"id\":\"field docs\"}}},\"funcs\":{\"run\":\"legacy docs\"}}},\"worlds\":{\"app\":{\"docs\":null,\"interface_import_docs\":{\"example:dep/api@1.0.0\":\"import docs\"}}}}"
  for version in [b'\x00', b'\x01'] {
    let bytes = metadata_input(encoded_fixture(), @utf8.encode(text), version~)
    let input = @verifier.decode_package(bytes).unwrap()
    assert_eq(input.bytes(), bytes)
    let model = @verifier.resolve_packages(Encoded(input)).unwrap()
    assert_eq(model.interfaces()[0].functions.length(), 1)
    assert_eq(model.sources().length(), 0)
  }
  for
    text in [
      "{\"unknown\":null}", "{\"interfaces\":{\"missing\":{}}}", "{\"interfaces\":{\"api\":{\"types\":{\"missing\":{}}}}}",
      "{\"interfaces\":{\"api\":{\"funcs\":{\"missing\":null}}}}", "{\"interfaces\":{\"api\":{\"types\":{\"id\":{\"items\":{\"x\":\"docs\"}}}}}}",
      "{\"interfaces\":{\"api\":{\"types\":{\"item\":{\"items\":{\"missing\":\"docs\"}}}}}}",
      "{\"worlds\":{\"missing\":{}}}", "{\"worlds\":{\"app\":{\"interface_import_docs\":{\"missing\":\"docs\"}}}}",
      "{\"docs\":\"a\",\"docs\":\"b\"}", "{\"interfaces\":{\"api\":null,\"api\":{}}}",
    ] {
    let bytes = metadata_input(encoded_fixture(), @utf8.encode(text))
    let errors = @verifier.decode_package(bytes, source_id="bad-metadata.wasm").unwrap_err()
    assert_eq(errors[0].code, "WIT-B004", msg=text)
    assert_eq(errors[0].primary.location.position, BinaryOffset(None))
  }
}

///|
test "metadata parsing retains serde ignored extensions and duplicate dictionary semantics" {
  for
    text in [
      "{\"interfaces\":{\"api\":{\"stability\":{\"unknown\":null}}}}", "{\"interfaces\":{\"api\":{\"stability\":{\"stable\":{\"since\":\"9.0.0\",\"x\":1e9999}}}}}",
      "{\"interfaces\":{\"api\":{\"stability\":{\"stable\":{\"since\":\"9.0.0\",\"x\":\"\\ud800\"}}}}}",
      "{\"interfaces\":{\"api\":{\"stability\":{\"stable\":{\"since\":\"9.0.0\",\"feature\":1,\"feature\":false}}}}}",
      "{\"interfaces\":{\"api\":{\"funcs\":{\"missing\":null}},\"api\":{}}}",
    ] {
    assert_eq(metadata_model(text).interfaces().length(), 1)
  }
  let text = "{\"interfaces\":{\"api\":{\"stability\":{\"stable\":{\"since\":\"1.0.0\"}}},\"api\":{\"stability\":{\"stable\":{\"since\":\"2.0.0\"}}}}}"
  assert_eq(
    metadata_model(text).interfaces()[0].stability,
    Stable("2.0.0", None),
  )
  let deep = "{\"interfaces\":{\"api\":{\"stability\":{\"stable\":{\"since\":\"9.0.0\",\"ignored\":" +
    "[".repeat(10000) +
    "null" +
    "]".repeat(10000) +
    "}}}}}"
  assert_eq(
    metadata_model(deep).interfaces()[0].stability,
    Stable("9.0.0", None),
  )
}

