  let input = @verifier.decode_package(metadata_input(base, data)).unwrap()
  let model = @verifier.resolve_packages(Encoded(input)).unwrap()
  let world = model.worlds()[0]
  let import_item = world.imports.filter(item => item.name == "item")[0]
