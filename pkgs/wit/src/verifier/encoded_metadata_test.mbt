  let data = @utf8.encode(
    "{\"worlds\":{\"app\":{\"stability\":{\"unstable\":{\"feature\":\"world\"}},\"interfaces\":{\"item\":{\"stability\":{\"unstable\":{\"feature\":\"inline\"}},\"types\":{\"n\":{\"stability\":{\"unstable\":{\"feature\":\"type\"}}}},\"funcs\":{\"f\":{\"stability\":{\"unstable\":{\"feature\":\"inner\"}}}}},\"host\":{\"stability\":{\"stable\":{\"since\":\"1.0.0\"}},\"funcs\":{\"f\":{\"stability\":{\"unstable\":{\"feature\":\"host\"}}}}}},\"interface_exports\":{\"item\":{\"stability\":{\"stable\":{\"since\":\"9.0.0\"}}},\"host\":{\"stability\":{\"stable\":{\"since\":\"2.0.0\"}}}},\"interface_export_stability\":{\"host\":{\"stable\":{\"since\":\"3.0.0\"}}},\"funcs\":{\"run\":{\"stability\":{\"unstable\":{\"feature\":\"world-function\"}}},\"out\":{\"stability\":{\"stable\":{\"since\":\"1.0.0\"}}}},\"func_exports\":{\"run\":{\"stability\":{\"stable\":{\"since\":\"9.0.0\"}}},\"out\":{\"stability\":{\"stable\":{\"since\":\"2.0.0\"}}}}}},\"interfaces\":{\"api\":{\"types\":{\"r\":{\"stability\":{\"stable\":{\"since\":\"9.0.0\"}}}}}}}",
