69\x6c\x65\x01\x04\x01\x68\x00\x01\x70\x7d\x01\x43\x02\x04\x73\x65\x6c\x66\x05\x01\x6e\x79\x00\x06\x04\x00\x11\x5b\x6d\x65\x74\x68\x6f\x64\x5d\x66\x69\x6c\x65\x2e\x72\x65\x61\x64\x01\x07\x01\x40\x01\x04\x73\x65\x6c\x66\x05\x01\x00\x04\x00\x12\x5b\x6d\x65\x74\x68\x6f\x64\x5d\x66\x69\x6c\x65\x2e\x63\x6c\x6f\x73\x65\x01\x08\x01\x40\x01\x04\x70\x61\x74\x68\x73\x00\x02\x04\x00\x11\x5b\x73\x74\x61\x74\x69\x63\x5d\x66\x69\x6c\x65\x2e\x6f\x70\x65\x6e\x01\x09\x01\x40\x01\x04\x73\x65\x6c\x66\x05\x00\x77\x04\x00\x1a\x5b\x6d\x65\x74\x68\x6f\x64\x5d\x5b\x67\x65\x74\x5d\x66\x69\x6c\x65\x2e\x70\x6f\x73\x69\x74\x69\x6f\x6e\x01\x0a\x01\x40\x02\x04\x73\x65\x6c\x66\x05\x05\x76\x61\x6c\x75\x65\x77\x01\x00\x04\x00\x1a\x5b\x6d\x65\x74\x68\x6f\x64\x5d\x5b\x73\x65\x74\x5d\x66\x69\x6c\x65\x2e\x70\x6f\x73\x69\x74\x69\x6f\x6e\x01\x0b\x01\x40\x00\x00\x77\x04\x00\x18\x5b\x73\x74\x61\x74\x69\x63\x5d\x5b\x67\x65\x74\x5d\x66\x69\x6c\x65\x2e\x73\x68\x61\x72\x65\x64\x01\x0c\x01\x40\x01\x05\x76\x61\x6c\x75\x65\x77\x01\x00\x04\x00\x18\x5b\x73\x74\x61\x74\x69\x63\x5d\x5b\x73\x65\x74\x5d\x66\x69\x6c\x65\x2e\x73\x68\x61\x72\x65\x64\x01\x0d\x01\x69\x01\x01\x40\x00\x00\x0e\x04\x00\x13\x5b\x63\x6f\x6e\x73\x74\x72\x75\x63\x74\x6f\x72\x5d\x73\x74\x72\x65\x61\x6d\x01\x0f\x01\x40\x00\x00\x7f\x04\x00\x0a\x5b\x67\x65\x74\x5d\x72\x65\x61\x64\x79\x01\x10\x01\x40\x01\x05\x76\x61\x6c\x75\x65\x7f\x01\x00\x04\x00\x0a\x5b\x73\x65\x74\x5d\x72\x65\x61\x64\x79\x01\x11\x04\x00\x1b\x65\x78\x61\x6d\x70\x6c\x65\x3a\x6d\x65\x74\x68\x6f\x64\x73\x2f\x66\x69\x6c\x65\x73\x40\x31\x2e\x30\x2e\x30\x05\x01\x04\x00\x19\x65\x78\x61\x6d\x70\x6c\x65\x3a\x6d\x65\x74\x68\x6f\x64\x73\x2f\x61\x70\x70\x40\x31\x2e\x30\x2e\x30\x04\x00\x0b\x09\x01\x00\x03\x61\x70\x70\x03\x02\x00\x00\x10\x0c\x70\x61\x63\x6b\x61\x67\x65\x2d\x64\x6f\x63\x73\x01\x7b\x7d\x00\x2f\x09\x70\x72\x6f\x64\x75\x63\x65\x72\x73\x01\x0c\x70\x72\x6f\x63\x65\x73\x73\x65\x64\x2d\x62\x79\x01\x0d\x77\x69\x74\x2d\x63\x6f\x6d\x70\x6f\x6e\x65\x6e\x74\x07\x30\x2e\x32\x36\x32\x2e\x30",
    source_id="methods.wasm",
  ).unwrap()
  let model = @verifier.resolve_packages(Encoded(input)).unwrap()
  let file = model
    .types()
    .filter(ty => ty.name == Some("file") && ty.kind is Resource)[0]
  let stream = model
    .types()
    .filter(ty => ty.name == Some("stream") && ty.kind is Resource)[0]
  let functions = model.interfaces()[0].functions
  assert_eq(functions.length(), 11)
  let get = fn(name : String) {
    functions.filter(function => function.name == name)[0]
  }
  let ty = fn(id : Int32) { model.types().filter(ty => ty.id == id)[0].kind }
  let read = get("[method]file.read")
  assert_eq(read.kind, Method(file.id))
  assert_true(read.asynchronous)
  assert_eq(read.params.length(), 2)
  assert_eq(read.params[0].name, "self")
  assert_eq(ty(read.params[0].ty), Borrow(file.id))
  assert_eq(ty(read.params[1].ty), Scalar("u32"))
  assert_true(ty(read.result.unwrap()) is List(_, None))
  let open = get("[static]file.open")
  assert_eq(open.kind, Static(file.id))
  assert_eq(open.params.length(), 1)
  assert_eq(ty(open.result.unwrap()), Own(file.id))
  let make_stream = get("[constructor]stream")
  assert_eq(make_stream.kind, Constructor(stream.id))
  assert_eq(make_stream.params.length(), 0)
  assert_eq(ty(make_stream.result.unwrap()), Own(stream.id))
  let make_file = get("[constructor]file")
  assert_eq(make_file.kind, Constructor(file.id))
  let result = ty(make_file.result.unwrap())
  guard result is Result(Some(success), Some(failure)) else {
    fail("fallible constructor result lost")
  }
  assert_eq(ty(success), Own(file.id))
  assert_eq(ty(failure), Scalar("string"))
  let position = get("[method][get]file.position")
  assert_eq(position.kind, Method(file.id))
  assert_eq(position.flavor, Getter)
  assert_eq(position.params.length(), 1)
  let set_position = get("[method][set]file.position")
  assert_eq(set_position.kind, Method(file.id))
  assert_eq(set_position.flavor, Setter)
  assert_eq(set_position.params.length(), 2)
  assert_eq(ty(set_position.params[0].ty), Borrow(file.id))
  assert_eq(get("[static][get]file.shared").kind, Static(file.id))
  assert_eq(get("[static][get]file.shared").params.length(), 0)
  assert_eq(get("[get]ready").kind, Freestanding)
  assert_eq(get("[get]ready").flavor, Getter)
  assert_eq(get("[set]ready").flavor, Setter)
  assert_true(
    functions.all(function => {
      function.location.position == BinaryOffset(None) &&
      model.origin(function.id).unwrap().node is None
    }),
  )
  let source = "package example:methods@1.0.0;\ninterface files {\n  resource file {\n    constructor(path: string) -> result<file, string>;\n    read: async func(n: u32) -> list<u8>;\n    close: func();\n    open: static func(path: string) -> file;\n    position: get() -> u64;\n    position: set(value: u64);\n    shared: static get() -> u64;\n    shared: static set(value: u64);\n  }\n  resource %stream { constructor(); }\n  ready: get() -> bool;\n  ready: set(value: bool);\n}\nworld app {\n  import files;\n  export files;\n}\n"
  let original = @verifier.resolve({
    documents: [section_document("methods.wit", source)],
  }).unwrap()
  assert_eq(model.world_summary(), original.world_summary())
}

///|
test "binary alias contracts do not relax source constructor or setter contracts" {
  let source = "package example:app;interface api{resource r{constructor()->own<r>;}}"
  let parsed = @parser.parse(source, features=@parser.Features::reference())
  assert_true(parsed.is_valid())
  let document = @verifier.Document::from_parse("spoof.wasm", source, parsed)
  let errors = @verifier.resolve_packages(Source({ documents: [document], })).unwrap_err()
  assert_true(errors.any(error => error.code == "WIT-S007"))
  let source = "package example:app;interface api{type answer=result<_,string>;type other=answer;value:get()->u32;value:set(x:u32)->other;}"
  let parsed = @parser.parse(source, features=@parser.Features::reference())
  assert_true(parsed.is_valid())
  let document = @verifier.Document::from_parse("spoof.wasm", source, parsed)
  let errors = @verifier.resolve_packages(Source({ documents: [document], })).unwrap_err()
  assert_true(errors.any(error => error.code == "WIT-S007"))
}

///|
test "encoded world function accessors retain import and export flavors" {
  let input = @verifier.decode_package(
    b"\x00\x61\x73\x6d\x0d\x00\x01\x00\x07\x82\x01\x01\x41\x02\x01\x41\x08\x01\x40\x00\x00\x79\x03\x00\x09\x5b\x67\x65\x74\x5d\x73\x69\x7a\x65\x01\x00\x01\x40\x01\x05\x76\x61\x6c\x75\x65\x79\x01\x00\x03\x00\x09\x5b\x73\x65\x74\x5d\x73\x69\x7a\x65\x01\x01\x01\x40\x00\x00\x7f\x04\x00\x0a\x5b\x67\x65\x74\x5d\x72\x65\x61\x64\x79\x01\x02\x01\x40\x01\x05\x76\x61\x6c\x75\x65\x7f\x01\x00\x04\x00\x0a\x5b\x73\x65\x74\x5d\x72\x65\x61\x64\x79\x01\x03\x04\x00\x1b\x65\x78\x61\x6d\x70\x6c\x65\x3a\x77\x6f\x72\x6c\x64\x2d\x61\x63\x63\x65\x73\x73\x6f\x72\x73\x2f\x61\x70\x70\x04\x00\x0b\x09\x01\x00\x03\x61\x70\x70\x03\x00\x00\x00\x10\x0c\x70\x61\x63\x6b\x61\x67\x65\x2d\x64\x6f\x63\x73\x01\x7b\x7d\x00\x2f\x09\x70\x72\x6f\x64\x75\x63\x65\x72\x73\x01\x0c\x70\x72\x6f\x63\x65\x73\x73\x65\x64\x2d\x62\x79\x01\x0d\x77\x69\x74\x2d\x63\x6f\x6d\x70\x6f\x6e\x65\x6e\x74\x07\x30\x2e\x32\x36\x32\x2e\x30",
  ).unwrap()
  let model = @verifier.resolve_packages(Encoded(input)).unwrap()
  let world = model.worlds()[0]
  assert_eq(world.imports.map(item => item.name), ["[get]size", "[set]size"])
  assert_eq(world.exports.map(item => item.name), ["[get]ready", "[set]ready"])
  assert_eq(model.functions().map(function => function.flavor), [
    Getter,
    Setter,
    Getter,
    Setter,
  ])
  assert_true(model.functions().all(function => function.kind is Freestanding))
}
