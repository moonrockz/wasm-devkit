///|
fn resource_members(tree : @ast.Tree) -> Map[Int32, Int32] {
  let result : Map[Int32, Int32] = Map([])
  for resource, node in tree.nodes {
    if node.data is Resource(methods~, ..) {
      for func_id in methods {
        result[func_id] = resource
      }
    }
  }
  result
}

///|
fn resource_function_name(
  tree : @ast.Tree,
  resource : Int32,
  item : Int32,
) -> String? {
  guard tree.nodes[resource].data is Resource(name=resource_name, ..) else {
    return None
  }
  match tree.nodes[item].data {
    Constructor(..) => Some("[constructor]" + resource_name)
    Function(name~, is_static~, signature~, ..) =>
      Some(
        (if is_static { "[static]" } else { "[method]" }) +
        signature_name(tree, signature, resource_name + "." + name),
      )
    _ => None
  }
}

///|
/// Canonicalization of the function annotations generated by this verifier.
/// The resource/method self-name rule precedes annotation preservation.
fn component_name_key(name : String) -> String {
  let mut rest = name
  let mut is_constructor = false
  if rest.has_prefix("[constructor]") {
    is_constructor = true
    rest = rest[13:].to_owned()
  } else if rest.has_prefix("[method]") || rest.has_prefix("[static]") {
    rest = rest[8:].to_owned()
  }
  let is_setter = rest.has_prefix("[set]")
  if rest.has_prefix("[get]") || is_setter {
    rest = rest[5:].to_owned()
  }
  let key = strong_name(rest)
  let parts = key.split(".").to_array()
  if parts.length() == 2 && parts[0] == parts[1] {
    return parts[0].to_owned()
  }
  (if is_constructor {
    "[constructor]"
  } else if is_setter {
    "[set]"
  } else {
    ""
  }) +
  key
}

///|
fn verify_constructors(
  prepared : Prepared,
  references : Map[Int32, Int32],
  errors : Array[Diagnostic],
  binary_sources~ : Map[String, Bool] = Map([]),
) -> Unit {
  let tree = prepared.tree
  let members = resource_members(tree)
  for id, node in tree.nodes {
    guard node.data is Constructor(result=Some(output), ..) &&
      members.get(id) is Some(resource) else {
      continue
    }
    if binary_sources.contains(prepared.origins[id].location.source) {
      let valid = match binary_type_root(tree, references, output) {
        Some(result) =>
          match tree.nodes[result].data {
            ResultType(ok=Some(ok), ..) =>
              binary_owned_resource(tree, references, ok) == Some(resource)
            _ =>
              binary_owned_resource(tree, references, result) == Some(resource)
          }
        None => false
      }
      if !valid {
        errors.push(
          prepared_error(
            prepared, output, "WIT-S007", "encoded constructor must construct its own resource",
          ),
        )
      }
      continue
    }
    // A named result may denote one declaration whose kind is directly Result.
    // An alias of that result or a use-alias has kind Type, not Result.
    let mut result = output
    if tree.nodes[result].data is NamedType(..) &&
      references.get(result) is Some(target) &&
      tree.nodes[target].data is Alias(ty~, ..) {
      result = ty
    }
    guard tree.nodes[result].data is ResultType(ok~, ..) else {
      errors.push(
        prepared_error(
          prepared, output, "WIT-S007", "a declared constructor result must be a result type",
        ),
      )
      continue
    }
    let success = match ok {
      Some(ok) => {
        let name = match tree.nodes[ok].data {
          NamedType(..) => Some(ok)
          OwnType(resource~) => Some(resource)
          _ => None
        }
        name is Some(name) && references.get(name) == Some(resource)
      }
      None => false
    }
    if !success {
      errors.push(
        prepared_error(
          prepared,
          ok.unwrap_or(output),
          "WIT-S007",
          "a constructor result must construct its own resource directly",
        ),
      )
    }
  }
}

///|
fn remap_function_kind(
  kind : FunctionKind,
  replace : (Int32) -> Int32,
) -> FunctionKind {
  match kind {
    Freestanding => Freestanding
    Method(id) => Method(replace(id))
    Static(id) => Static(replace(id))
    Constructor(id) => Constructor(replace(id))
  }
}

///|
fn function_resource(kind : FunctionKind) -> Int32? {
  match kind {
    Freestanding => None
    Method(id) | Static(id) | Constructor(id) => Some(id)
  }
}

///|
fn remap_function_name(
  name : String,
  kind : FunctionKind,
  flavor : FunctionFlavor,
  resource : String,
) -> String {
  match kind {
    Freestanding => name
    Constructor(_) => "[constructor]" + resource
    Method(_) | Static(_) => {
      let parts = name.split(".").to_array()
      (if kind is Method(_) { "[method]" } else { "[static]" }) +
      flavor_prefix(flavor) +
      resource +
      "." +
      parts[parts.length() - 1].to_owned()
    }
  }
}

///|
// Component type aliases are transparent to the binary constructor/accessor
// contracts. Source declarations retain the pinned source alias boundaries.
fn binary_type_root(
  tree : @ast.Tree,
  references : Map[Int32, Int32],
  start : Int32,
) -> Int32? {
  let mut current = start
  for _ in 0..<tree.nodes.length() {
    match tree.nodes[current].data {
      Alias(ty~, ..) => current = ty
      NamedType(..) | Rename(..) =>
        match references.get(current) {
          Some(target) => current = target
          None => return None
        }
      _ => return Some(current)
    }
  }
  None
}

///|
fn binary_owned_resource(
  tree : @ast.Tree,
  references : Map[Int32, Int32],
  start : Int32,
) -> Int32? {
  guard binary_type_root(tree, references, start) is Some(root) else {
    return None
  }
  match tree.nodes[root].data {
    OwnType(resource~) => binary_type_root(tree, references, resource)
    Resource(..) => Some(root)
    _ => None
  }
}
