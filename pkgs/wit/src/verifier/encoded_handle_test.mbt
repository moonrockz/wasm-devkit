        false,
      ),
    ] {
    let inputs = [
      @verifier.decode_wat_package(wat),
      @verifier.decode_package(bytes),
    ]
    for input in inputs {
      if accepted {
        let decoded = match input {
          Ok(value) => value
          Err(errors) => fail(wat + "\n" + @debug.to_string(errors))
        }
        ignore(@verifier.resolve_packages(Encoded(decoded)).unwrap())
      } else {
        assert_eq(input.unwrap_err()[0].code, "WIT-B003")
      }
    }
  }
}

///|
test "included world handles keep local and interface resource identities" {
  let source = "package example:app; interface api{resource external;} world base{use api.{external};resource r;import f:func(x:own<r>,y:borrow<external>)->r;}world app{include base;}\n"
  let wat = "(component\n  (type (;0;)\n    (component\n      (type (;0;)\n        (instance\n          (export (;0;) \"external\" (type (sub resource)))\n        )\n      )\n      (export (;0;) \"example:app/api\" (instance (type 0)))\n    )\n  )\n  (export (;1;) \"api\" (type 0))\n  (type (;2;)\n    (component\n      (type (;0;)\n        (component\n          (type (;0;)\n            (instance\n              (export (;0;) \"external\" (type (sub resource)))\n            )\n          )\n          (import \"example:app/api\" (instance (;0;) (type 0)))\n          (alias export 0 \"external\" (type (;1;)))\n          (import \"external\" (type (;2;) (eq 1)))\n          (import \"r\" (type (;3;) (sub resource)))\n          (type (;4;) (own 3))\n          (type (;5;) (borrow 2))\n          (type (;6;) (func (param \"x\" 4) (param \"y\" 5) (result 4)))\n          (import \"f\" (func (;0;) (type 6)))\n        )\n      )\n      (export (;0;) \"example:app/base\" (component (type 0)))\n    )\n  )\n  (export (;3;) \"base\" (type 2))\n  (type (;4;)\n    (component\n      (type (;0;)\n        (component\n          (type (;0;)\n            (instance\n              (export (;0;) \"external\" (type (sub resource)))\n            )\n          )\n          (import \"example:app/api\" (instance (;0;) (type 0)))\n          (alias export 0 \"external\" (type (;1;)))\n          (import \"external\" (type (;2;) (eq 1)))\n          (import \"r\" (type (;3;) (sub resource)))\n          (type (;4;) (own 3))\n          (type (;5;) (borrow 2))\n          (type (;6;) (func (param \"x\" 4) (param \"y\" 5) (result 4)))\n          (import \"f\" (func (;0;) (type 6)))\n        )\n      )\n      (export (;0;) \"example:app/app\" (component (type 0)))\n    )\n  )\n  (export (;5;) \"app\" (type 4))\n  (@custom \"package-docs\" \"\\01{}\")\n  (@producers\n    (processed-by \"wit-component\" \"0.262.0\")\n  )\n)\n"
  let bytes = b"\x00\x61\x73\x6d\x0d\x00\x01\x00\x07\x27\x01\x41\x02\x01\x42\x01\x04\x00\x08\x65\x78\x74\x65\x72\x6e\x61\x6c\x03\x01\x04\x00\x0f\x65\x78\x61\x6d\x70\x6c\x65\x3a\x61\x70\x70\x2f\x61\x70\x69\x05\x00\x0b\x09\x01\x00\x03\x61\x70\x69\x03\x00\x00\x07\x77\x01\x41\x02\x01\x41\x09\x01\x42\x01\x04\x00\x08\x65\x78\x74\x65\x72\x6e\x61\x6c\x03\x01\x03\x00\x0f\x65\x78\x61\x6d\x70\x6c\x65\x3a\x61\x70\x70\x2f\x61\x70\x69\x05\x00\x02\x03\x00\x00\x08\x65\x78\x74\x65\x72\x6e\x61\x6c\x03\x00\x08\x65\x78\x74\x65\x72\x6e\x61\x6c\x03\x00\x01\x03\x00\x01\x72\x03\x01\x01\x69\x03\x01\x68\x02\x01\x40\x02\x01\x78\x04\x01\x79\x05\x00\x04\x03\x00\x01\x66\x01\x06\x04\x00\x10\x65\x78\x61\x6d\x70\x6c\x65\x3a\x61\x70\x70\x2f\x62\x61\x73\x65\x04\x00\x0b\x0a\x01\x00\x04\x62\x61\x73\x65\x03\x02\x00\x07\x76\x01\x41\x02\x01\x41\x09\x01\x42\x01\x04\x00\x08\x65\x78\x74\x65\x72\x6e\x61\x6c\x03\x01\x03\x00\x0f\x65\x78\x61\x6d\x70\x6c\x65\x3a\x61\x70\x70\x2f\x61\x70\x69\x05\x00\x02\x03\x00\x00\x08\x65\x78\x74\x65\x72\x6e\x61\x6c\x03\x00\x08\x65\x78\x74\x65\x72\x6e\x61\x6c\x03\x00\x01\x03\x00\x01\x72\x03\x01\x01\x69\x03\x01\x68\x02\x01\x40\x02\x01\x78\x04\x01\x79\x05\x00\x04\x03\x00\x01\x66\x01\x06\x04\x00\x0f\x65\x78\x61\x6d\x70\x6c\x65\x3a\x61\x70\x70\x2f\x61\x70\x70\x04\x00\x0b\x09\x01\x00\x03\x61\x70\x70\x03\x04\x00\x00\x10\x0c\x70\x61\x63\x6b\x61\x67\x65\x2d\x64\x6f\x63\x73\x01\x7b\x7d\x00\x2f\x09\x70\x72\x6f\x64\x75\x63\x65\x72\x73\x01\x0c\x70\x72\x6f\x63\x65\x73\x73\x65\x64\x2d\x62\x79\x01\x0d\x77\x69\x74\x2d\x63\x6f\x6d\x70\x6f\x6e\x65\x6e\x74\x07\x30\x2e\x32\x36\x32\x2e\x30"
  let expected = @verifier.resolve({
    documents: [section_document("source.wit", source)],
  }).unwrap()
  for
    input in [
      @verifier.decode_package(bytes).unwrap(),
      @verifier.decode_wat_package(wat).unwrap(),
    ] {
    let actual = @verifier.resolve_packages(Encoded(input)).unwrap()
    assert_eq(actual.world_summary(), expected.world_summary())
    assert_eq(
      encoded_alias_model(actual, reachable_only=true),
      encoded_alias_model(expected, reachable_only=true),
    )
  }
}
