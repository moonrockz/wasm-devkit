      ),
      (
        "missing-implements", "(component (type (component (type (component (type (instance)) (import \"local\" (implements \"test:dep/base\") (version-suffix \".0.0\") (instance (type 0))))) (export \"test:root/app\" (component (type 0))))) (export \"app\" (type 0)))",
        b"\x00\x61\x73\x6d\x0d\x00\x01\x00\x07\x3b\x01\x41\x02\x01\x41\x02\x01\x42\x00\x03\x02\x05\x6c\x6f\x63\x61\x6c\x02\x00\x0d\x74\x65\x73\x74\x3a\x64\x65\x70\x2f\x62\x61\x73\x65\x01\x04\x2e\x30\x2e\x30\x05\x00\x04\x00\x0d\x74\x65\x73\x74\x3a\x72\x6f\x6f\x74\x2f\x61\x70\x70\x04\x00\x0b\x09\x01\x00\x03\x61\x70\x70\x03\x00\x00",
        false, true,
      ),
    ] {
    let compiled = @component_text.parse_normalized_component_wat(text)
    assert_eq(compiled, bytes, msg=name)
    let strict = @binary.validate_type_component(bytes)
    let legacy = @binary.validate_declarative_component(bytes)
    assert_eq(strict is Ok(_), wit, msg="WIT " + name)
    assert_eq(legacy is Ok(_), wac, msg="WAC " + name)
    let decoded = decode_wat_package(text)
    assert_eq(decoded is Ok(_), wit, msg="decode " + name)
    if decoded is Ok(input) {
      assert_true(
        resolve_packages(Encoded(input)) is Ok(_),
        msg="resolve " + name,
      )
    }
  }
}

///|
test "version suffix attributes reject malformed UTF-8 and WAT syntax" {
  let bad_suffix = b"\x00\x61\x73\x6d\x0d\x00\x01\x00\x07\x03\x01\x42\x00\x0a\x22\x01\x02\x05\x6c\x6f\x63\x61\x6c\x02\x00\x0f\x74\x65\x73\x74\x3a\x64\x65\x70\x2f\x62\x61\x73\x65\x40\x31\x01\x04\x2e\x32\x2e\xff\x05\x00"
  assert_true(@binary.validate_declarative_component(bad_suffix) is Err(_))
  let bad_implements = b"\x00\x61\x73\x6d\x0d\x00\x01\x00\x07\x03\x01\x42\x00\x0a\x22\x01\x02\x05\x6c\x6f\x63\x61\x6c\x02\x00\x0f\x74\x65\x73\x74\x3a\x64\x65\x70\x2f\x62\x61\x73\x65\x40\xff\x01\x04\x2e\x32\x2e\x33\x05\x00"
  assert_true(@binary.validate_declarative_component(bad_implements) is Err(_))
  assert_true(
    try {
      let _ = @component_text.parse_normalized_component_wat(
        "(component (import \"test:dep/base@1\" (versionsuffix \".2.3\") (instance)))",
      )
      false
    } catch {
      _ => true
    },
  )
  assert_true(
    try {
      let _ = @component_text.parse_normalized_component_wat(
        "(component (import \"test:dep/base@1\" (version-suffix .2.3) (instance)))",
      )
      false
    } catch {
      _ => true
    },
  )
  assert_true(
    try {
      let _ = @component_text.parse_normalized_component_wat(
        "(component (import \"test:dep/base@1\" (version-suffix \".2.3\") (version-suffix \".2.3\") (instance)))",
      )
      false
    } catch {
      _ => true
    },
  )
  assert_true(
    try {
      let _ = @component_text.parse_normalized_component_wat(
        "(component (import \"local\" (version-suffix \".2.3\") (implements \"test:dep/base@1\") (instance)))",
      )
      false
    } catch {
      _ => true
    },
  )
  assert_true(
    try {
      let _ = @component_text.parse_normalized_component_wat(
        "(component (import \"test:dep/base@1\" (external-id \"id\") (version-suffix \".2.3\") (instance)))",
      )
      false
    } catch {
      _ => true
    },
  )
}

///|
test "version validation retains the entire payload after the first at sign" {
  for
    (name, bytes, wac) in [
      (
        "multi-at", b"\x00\x61\x73\x6d\x0d\x00\x01\x00\x07\x34\x01\x41\x02\x01\x41\x02\x01\x42\x00\x03\x00\x14\x74\x65\x73\x74\x3a\x64\x65\x70\x2f\x61\x70\x69\x40\x31\x40\x32\x2e\x33\x2e\x34\x05\x00\x04\x00\x0d\x74\x65\x73\x74\x3a\x72\x6f\x6f\x74\x2f\x61\x70\x70\x04\x00\x0b\x09\x01\x00\x03\x61\x70\x70\x03\x00\x00",
        false,
      ),
      (
        "multi-at-suffix", b"\x00\x61\x73\x6d\x0d\x00\x01\x00\x07\x37\x01\x41\x02\x01\x41\x02\x01\x42\x00\x03\x02\x10\x74\x65\x73\x74\x3a\x64\x65\x70\x2f\x61\x70\x69\x40\x31\x40\x32\x01\x01\x04\x2e\x33\x2e\x34\x05\x00\x04\x00\x0d\x74\x65\x73\x74\x3a\x72\x6f\x6f\x74\x2f\x61\x70\x70\x04\x00\x0b\x09\x01\x00\x03\x61\x70\x70\x03\x00\x00",
        false,
      ),
      (
        "multi-at-implements", b"\x00\x61\x73\x6d\x0d\x00\x01\x00\x07\x3c\x01\x41\x02\x01\x41\x02\x01\x42\x00\x03\x02\x05\x6c\x6f\x63\x61\x6c\x01\x00\x14\x74\x65\x73\x74\x3a\x64\x65\x70\x2f\x61\x70\x69\x40\x31\x40\x32\x2e\x33\x2e\x34\x05\x00\x04\x00\x0d\x74\x65\x73\x74\x3a\x72\x6f\x6f\x74\x2f\x61\x70\x70\x04\x00\x0b\x09\x01\x00\x03\x61\x70\x70\x03\x00\x00",
        true,
      ),
      (
        "multi-at-implements-suffix", b"\x00\x61\x73\x6d\x0d\x00\x01\x00\x07\x3e\x01\x41\x02\x01\x41\x02\x01\x42\x00\x03\x02\x05\x6c\x6f\x63\x61\x6c\x02\x00\x10\x74\x65\x73\x74\x3a\x64\x65\x70\x2f\x61\x70\x69\x40\x31\x40\x32\x01\x04\x2e\x33\x2e\x34\x05\x00\x04\x00\x0d\x74\x65\x73\x74\x3a\x72\x6f\x6f\x74\x2f\x61\x70\x70\x04\x00\x0b\x09\x01\x00\x03\x61\x70\x70\x03\x00\x00",
        true,
      ),
    ] {
    assert_true(@binary.validate_type_component(bytes) is Err(_), msg=name)
    assert_eq(
      @binary.validate_declarative_component(bytes) is Ok(_),
      wac,
      msg=name,
    )
  }
}

///|
test "version suffix sorts and bare labels retain separate pinned rules" {
  let bytes = @component_text.parse_normalized_component_wat(
    "(component (import \"f\" (version-suffix \".0.0\") (func)))",
  )
  assert_true(@binary.validate_declarative_component(bytes) is Err(_))
  let bytes = @component_text.parse_normalized_component_wat(
    "(component (import \"local\" (version-suffix \".0.0\") (instance)))",
  )
  assert_true(@binary.validate_declarative_component(bytes) is Ok(_))
}
