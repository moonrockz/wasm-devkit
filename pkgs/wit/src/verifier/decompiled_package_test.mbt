///|
test "printed WIT packages decode to the same model as their binaries" {
  for fixture in decompiled_package_fixtures() {
    let (name, bytes) = fixture
    guard @decompiler.print_component(bytes, source_id=name + ".wasm")
      is Ok(printed) else {
      fail("\{name}: package rejected")
    }
    let binary = @verifier.decode_package(bytes, source_id=name + ".wasm")
    let text = @verifier.decode_wat_package(
      printed.root().text,
      source_id=name + ".wat",
    )
    let binary = @verifier.resolve_packages(Encoded(binary.unwrap())).unwrap()
    let text = @verifier.resolve_packages(Encoded(text.unwrap())).unwrap()
    assert_eq(model_projection(text), model_projection(binary), msg=name)
    assert_eq(text.world_summary(), binary.world_summary(), msg=name)
  }
}
