  compatibility_fixture(
    b"\x00\x61\x73\x6d\x01\x00\x00\x00\x00\x3d\x08\x64\x79\x6c\x69\x6e\x6b\x2e\x30\x01\x04\x05\x02\x03\x00\x02\x0b\x02\x04\x61\x2e\x73\x6f\x04\x62\x2e\x73\x6f\x03\x04\x01\x01\x66\x21\x04\x08\x01\x03\x65\x6e\x76\x01\x67\x10\x05\x06\x01\x04\x2f\x6c\x69\x62\x06\x07\x06\x77\x61\x73\x6d\x33\x32",
    (
      #|(module
      #|  (@dylink.0
      #|    (mem-info (memory 5 2) (table 3 0))
      #|    (needed "a.so" "b.so")
      #|    (export-info "f" binding-weak exported)
      #|    (import-info "env" "g" undefined)
      #|    (runtime-path "/lib")
