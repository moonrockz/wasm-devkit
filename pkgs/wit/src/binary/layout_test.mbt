///|
// Original fixtures checked with wasm-tools 1.262.0 validate --features all.
test "component ABI bounds include padding and aliases across type scopes" {
  for
    (name, bytes, expected) in [
      (
        "list-count", b"\x00\x61\x73\x6d\x0d\x00\x01\x00\x07\x08\x01\x67\x7d\x81\x80\x80\x80\x04",
        false,
      ),
      (
        "byte-boundary-ok", b"\x00\x61\x73\x6d\x0d\x00\x01\x00\x07\x07\x01\x67\x7d\xff\xff\xff\x7f",
        true,
      ),
      (
        "byte-boundary-bad", b"\x00\x61\x73\x6d\x0d\x00\x01\x00\x07\x08\x01\x67\x7d\x80\x80\x80\x80\x01",
        false,
      ),
      (
        "wide-boundary-ok", b"\x00\x61\x73\x6d\x0d\x00\x01\x00\x07\x07\x01\x67\x77\xff\xff\xff\x0f",
        true,
      ),
      (
        "wide-boundary-bad", b"\x00\x61\x73\x6d\x0d\x00\x01\x00\x07\x07\x01\x67\x77\x80\x80\x80\x10",
        false,
      ),
      (
        "record-padding", b"\x00\x61\x73\x6d\x0d\x00\x01\x00\x07\x13\x02\x67\x77\xff\xff\xff\x0f\x72\x02\x03\x70\x61\x64\x7d\x03\x62\x69\x67\x00",
        false,
      ),
      (
        "variant-padding", b"\x00\x61\x73\x6d\x0d\x00\x01\x00\x07\x18\x02\x67\x77\xff\xff\xff\x0f\x71\x02\x05\x65\x6d\x70\x74\x79\x00\x00\x03\x62\x69\x67\x01\x00\x00",
        false,
      ),
      (
        "outer-alias", b"\x00\x61\x73\x6d\x0d\x00\x01\x00\x07\x1b\x02\x67\x77\xff\xff\xff\x0f\x42\x02\x02\x03\x02\x01\x00\x01\x72\x02\x03\x70\x61\x64\x7d\x03\x62\x69\x67\x00",
        false,
      ),
      (
        "instance-alias", b"\x00\x61\x73\x6d\x0d\x00\x01\x00\x07\x31\x01\x41\x04\x01\x42\x02\x01\x67\x77\xff\xff\xff\x0f\x04\x00\x03\x62\x69\x67\x03\x00\x00\x03\x00\x01\x78\x05\x00\x02\x03\x00\x00\x03\x62\x69\x67\x01\x72\x02\x03\x70\x61\x64\x7d\x03\x62\x69\x67\x01",
        false,
      ),
      (
        "instance-alias-ok", b"\x00\x61\x73\x6d\x0d\x00\x01\x00\x07\x2e\x01\x41\x04\x01\x42\x02\x01\x67\x77\x04\x04\x00\x03\x62\x69\x67\x03\x00\x00\x03\x00\x01\x78\x05\x00\x02\x03\x00\x00\x03\x62\x69\x67\x01\x72\x02\x03\x70\x61\x64\x7d\x03\x62\x69\x67\x01",
        true,
      ),
      (
        "outer-alias-ok", b"\x00\x61\x73\x6d\x0d\x00\x01\x00\x07\x18\x02\x67\x77\x04\x42\x02\x02\x03\x02\x01\x00\x01\x72\x02\x03\x70\x61\x64\x7d\x03\x62\x69\x67\x00",
        true,
      ),
    ] {
    let result = @binary.validate_type_component(bytes)
    assert_eq(result is Ok(_), expected, msg=name)
    if result is Err(errors) {
      assert_eq(errors[0].code, "WIT-B003", msg=name)
    }
  }
}
