// Use the pinned dependency model without duplicating its types.

///|
using @component {
  type TypeDef,
  type PrimValType,
  type ValType,
  type Param,
  type FuncType,
  type NameAttribute,
  type TypeBound,
  type ValueBound,
  type ExternDesc,
  type ComponentDecl,
  type InstanceDecl,
  type VariantCase,
  type RecordField,
}
