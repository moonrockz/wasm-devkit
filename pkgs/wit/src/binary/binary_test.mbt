///|
fn bundle() -> Bytes {
  b"\x00\x61\x73\x6d\x0d\x00\x01\x00\x07\x4b\x01\x41\x02\x01\x42\x06\x01\x79\x04\x00\x02\x69\x64\x03\x00\x00\x01\x72\x01\x02\x69\x64\x01\x04\x00\x04\x69\x74\x65\x6d\x03\x00\x02\x01\x40\x01\x01\x78\x03\x00\x73\x04\x00\x03\x72\x75\x6e\x01\x04\x04\x00\x15\x65\x78\x61\x6d\x70\x6c\x65\x3a\x64\x65\x70\x2f\x61\x70\x69\x40\x31\x2e\x30\x2e\x30\x05\x00\x0b\x09\x01\x00\x03\x61\x70\x69\x03\x00\x00\x07\xb0\x01\x01\x41\x02\x01\x41\x04\x01\x42\x06\x01\x79\x04\x00\x02\x69\x64\x03\x00\x00\x01\x72\x01\x02\x69\x64\x01\x04\x00\x04\x69\x74\x65\x6d\x03\x00\x02\x01\x40\x01\x01\x78\x03\x00\x73\x04\x00\x03\x72\x75\x6e\x01\x04\x03\x00\x15\x65\x78\x61\x6d\x70\x6c\x65\x3a\x64\x65\x70\x2f\x61\x70\x69\x40\x31\x2e\x30\x2e\x30\x05\x00\x01\x42\x06\x01\x79\x04\x00\x02\x69\x64\x03\x00\x00\x01\x72\x01\x02\x69\x64\x01\x04\x00\x04\x69\x74\x65\x6d\x03\x00\x02\x01\x40\x01\x01\x78\x03\x00\x73\x04\x00\x03\x72\x75\x6e\x01\x04\x04\x00\x15\x65\x78\x61\x6d\x70\x6c\x65\x3a\x64\x65\x70\x2f\x61\x70\x69\x40\x31\x2e\x30\x2e\x30\x05\x01\x04\x00\x15\x65\x78\x61\x6d\x70\x6c\x65\x3a\x64\x65\x70\x2f\x61\x70\x70\x40\x31\x2e\x30\x2e\x30\x04\x00\x0b\x09\x01\x00\x03\x61\x70\x70\x03\x02\x00\x00\x10\x0c\x70\x61\x63\x6b\x61\x67\x65\x2d\x64\x6f\x63\x73\x01\x7b\x7d\x00\x2f\x09\x70\x72\x6f\x64\x75\x63\x65\x72\x73\x01\x0c\x70\x72\x6f\x63\x65\x73\x73\x65\x64\x2d\x62\x79\x01\x0d\x77\x69\x74\x2d\x63\x6f\x6d\x70\x6f\x6e\x65\x6e\x74\x07\x30\x2e\x32\x36\x32\x2e\x30"
}

///|
test "pinned encoder bytes validate without exposing mutable parser state" {
  let bytes = bundle()
  let valid = @binary.validate_type_component(bytes, source_id="dep.wasm").unwrap()
  assert_eq(valid.bytes(), bytes)
}

///|
test "every truncation and malformed framing fails with binary provenance" {
  let bytes = bundle()
  for end in 0..<bytes.length() {
    // Generated by wasm-tools 1.262.0 validate for every prefix of this fixture.
    let truncated = bytes[0:end].to_owned()
    let result = @binary.validate_type_component(
      truncated,
      source_id="dep.wasm",
    )
    assert_eq(
      result is Ok(_),
      [8, 85, 96, 275, 286, 304].contains(end),
      msg="prefix \{end}",
    )
    if result is Err(errors) {
      assert_eq(errors[0].source, "dep.wasm")
      assert_true(errors[0].offset.map(offset => offset <= end).unwrap_or(true))
    }
  }
  for
    bytes in [
      b"", b"\x00asm\x0d\x00\x01\x00\x07\xff\xff\xff\xff\x7f", b"\x00asm\x0d\x00\x01\x00\x00\x03\x02\xc0\x80",
    ] {
    assert_true(@binary.validate_type_component(bytes) is Err(_))
  }
}

///|
test "law: binary validation is total deterministic and retains byte offsets" {
  @quickcheck.check(
    (input : Array[Byte]) => {
      let bytes = Bytes::from_array(input)
      match @binary.validate_type_component(bytes, source_id="fuzz.wasm") {
        Ok(valid) => valid.bytes() == bytes
        Err(errors) =>
          errors.all(error => {
            error.source == "fuzz.wasm" &&
            error.offset
            .map(offset => offset >= 0 && offset <= bytes.length())
            .unwrap_or(true)
          }) &&
          @binary.validate_type_component(bytes, source_id="fuzz.wasm")
          is Err(again) &&
          again == errors
      }
    },
    count=500,
    max_size=256,
    seed=262015,
  )
}

///|
test "component validation rejects framed but invalid type metadata" {
  let bytes = b"\x00\x61\x73\x6d\x0d\x00\x01\x00\x07\x0b\x01\x42\x01\x04\x00\x03\x72\x75\x6e\x01\x00"
  guard @binary.validate_type_component(bytes) is Err(errors) else {
    fail("invalid function type accepted")
  }
  assert_eq(errors[0].code, "WIT-B003")
  assert_eq(errors[0].offset, None)
}

///|
fn component_with_types(payload : Array[Byte]) -> Bytes {
  let bytes : Array[Byte] = [0, 97, 115, 109, 13, 0, 1, 0, 7]
  let mut length = payload.length()
  while length >= 128 {
    bytes.push(((length & 127) | 128).to_byte())
    length = length >> 7
  }
  bytes.push(length.to_byte())
  bytes.append(payload)
  Bytes::from_array(bytes)
}

///|
test "deep physical type scopes reject before entering dependency recursion" {
  let payload : Array[Byte] = [1]
  for _ in 0..<10000 {
    payload.append([0x41, 1, 1])
  }
  payload.push(0x79)
  let bytes = component_with_types(payload)
  guard @binary.validate_type_component(bytes) is Err(errors) else {
    fail("excessive scope nesting accepted")
  }
  assert_eq(errors[0].code, "WIT-B002")
  assert_true(errors[0].offset.unwrap() < 1000)
}

///|
test "law: malformed type sections cannot panic the dependency parser" {
  @quickcheck.check(
    (payload : Array[Byte]) => {
      let bytes = component_with_types(payload)
      match @binary.validate_type_component(bytes) {
        Ok(valid) => valid.bytes() == bytes
        Err(errors) =>
          errors.all(error => {
            error.offset
            .map(offset => offset >= 0 && offset <= bytes.length())
            .unwrap_or(true)
          })
      }
    },
    count=1000,
    max_size=128,
    seed=262017,
  )
}
