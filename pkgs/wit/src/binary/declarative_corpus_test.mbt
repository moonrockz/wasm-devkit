// Binary encodings of WAC 0.12.0 dependency fixtures.
// Revision, licenses, source hashes and exclusions: fixtures/wac/README.md.
// Expected acceptance: pinned wac_types::Package::from_bytes.

///|
test "declarative corpus fail/duplicate-inst-args/foo/bar.wat" {
  let result = @binary.validate_declarative_component(
    b"\x00\x61\x73\x6d\x0d\x00\x01\x00\x07\x05\x01\x40\x00\x01\x00\x0a\x08\x01\x00\x03\x66\x6f\x6f\x01\x00",
  )
  assert_eq(
    result is Ok(_),
    true,
    msg=match result {
      Ok(_) => "accepted"
      Err(errors) => errors[0].message
    },
  )
}

