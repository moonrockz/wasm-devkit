    b"\x00\x61\x73\x6d\x0d\x00\x01\x00\x07\x13\x01\x42\x03\x01\x6a\x01\x73\x00\x01\x40\x00\x00\x00\x04\x00\x01\x66\x01\x01\x0a\x06\x01\x00\x01\x78\x05\x00",
  )
  assert_eq(
    result is Ok(_),
    true,
    msg=match result {
      Ok(_) => "accepted"
      Err(errors) => errors[0].message
    },
  )
}

