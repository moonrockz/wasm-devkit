lice of length  \\07\\10\\00\\12\\00\\00\\002\\07\\10\\00\\22\\00\\00\\00\")\n  )\n  (core instance (;0;) (instantiate 0))\n  (alias core export 0 \"memory\" (core memory (;0;)))\n  (alias core export 0 \"cabi_realloc\" (core func (;0;)))\n  (type (;0;) (func (result string)))\n  (alias core export 0 \"hello\" (core func (;1;)))\n  (alias core export 0 \"cabi_post_hello\" (core func (;2;)))\n  (func (;0;) (type 0) (canon lift (core func 1) (memory 0) string-encoding=utf8 (post-return 2)))\n  (export (;1;) \"hello\" (func 0))\n)\n",
  ].join("")
  let result = @verifier.decode_wat_component_package(text)
  assert_eq(
    result is Ok(_),
    true,
    msg=match result {
      Ok(_) => "accepted"
      Err(e) => e[0].render()
    },
  )
  let expected = [
    "world", "", "0", "0", "1", "hello", "func", "function", "false", "0", "some",
    "scalar", "string", "instance", "interface", "", "0", "1", "hello", "func", "function",
    "false", "0", "some", "scalar", "string", "definitions", "0",
  ]
  assert_eq(binary_projection(result.unwrap()), expected)
  let bytes = result.unwrap().bytes()
  let source = "package test:app; let i = new test:dep {...}; export i as \"out\";\n"
  let resolved = @verifier.verify(@parser.parse(source), source~, dependencies=[
    { name: "test:dep", version: None, source: "hello.wat", bytes, },
  ])
  assert_eq(
    resolved is Ok(_),
    true,
    msg=match resolved {
      Ok(_) => "accepted"
      Err(e) => e[0].render()
    },
  )
  let expected = [
    "0", "1", "out", "instance", "interface", "", "0", "1", "hello", "func", "function",
    "false", "0", "some", "scalar", "string",
  ]
  assert_eq(source_projection(resolved.unwrap()), expected)
}

