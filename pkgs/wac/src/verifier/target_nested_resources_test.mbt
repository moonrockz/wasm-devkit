// Original nested-component resource witnesses, independent of pinned name-only comparison.
// (component (type $expected (component (type $api (instance (export "handle" (type (sub resource))))) (import "a" (instance $a (type $api))) (alias export $a "handle" (type $h)) (type $b (instance (alias outer 1 $h (type $h)) (export "handle" (type (eq $h))))) (import "b" (instance (type $b))))) (type $provided (component (type $api (instance (export "handle" (type (sub resource))))) (import "a" (instance (type $api))) (import "b" (instance (type $api))))) (type $world (component (alias outer 1 $expected (type $expected)) (import "c" (component (type $expected))))) (type $wrapper (component (alias outer 1 $world (type $world)) (export "test:target/w" (component (type $world))))) (export "w" (type $wrapper)) (type $provider (component (alias outer 1 $provided (type $provided)) (export "test:target/provider" (component (type $provided))))) (export "provider" (type $provider)))

///|
test "target nested-aliased-target resource polarity" {
  let source = "package test:app targets lookup:target/w; import c as c: lookup:target/provider;"
  let dependencies : ReadOnlyArray[@verifier.PackageSource] = [
    {
      name: "lookup:target",
      version: None,
      source: "target.wasm",
      bytes: b"\x00\x61\x73\x6d\x0d\x00\x01\x00\x07\x7e\x04\x41\x05\x01\x42\x01\x04\x00\x06\x68\x61\x6e\x64\x6c\x65\x03\x01\x03\x00\x01\x61\x05\x00\x02\x03\x00\x00\x06\x68\x61\x6e\x64\x6c\x65\x01\x42\x02\x02\x03\x02\x01\x01\x04\x00\x06\x68\x61\x6e\x64\x6c\x65\x03\x00\x00\x03\x00\x01\x62\x05\x02\x41\x03\x01\x42\x01\x04\x00\x06\x68\x61\x6e\x64\x6c\x65\x03\x01\x03\x00\x01\x61\x05\x00\x03\x00\x01\x62\x05\x00\x41\x02\x02\x03\x02\x01\x00\x03\x00\x01\x63\x04\x00\x41\x02\x02\x03\x02\x01\x02\x04\x00\x0d\x74\x65\x73\x74\x3a\x74\x61\x72\x67\x65\x74\x2f\x77\x04\x00\x0b\x07\x01\x00\x01\x77\x03\x03\x00\x07\x21\x01\x41\x02\x02\x03\x02\x01\x01\x04\x00\x14\x74\x65\x73\x74\x3a\x74\x61\x72\x67\x65\x74\x2f\x70\x72\x6f\x76\x69\x64\x65\x72\x04\x00\x0b\x0e\x01\x00\x08\x70\x72\x6f\x76\x69\x64\x65\x72\x03\x05\x00\x00\x41\x0e\x63\x6f\x6d\x70\x6f\x6e\x65\x6e\x74\x2d\x6e\x61\x6d\x65\x01\x30\x03\x05\x00\x08\x65\x78\x70\x65\x63\x74\x65\x64\x01\x08\x70\x72\x6f\x76\x69\x64\x65\x64\x02\x05\x77\x6f\x72\x6c\x64\x03\x07\x77\x72\x61\x70\x70\x65\x72\x05\x08\x70\x72\x6f\x76\x69\x64\x65\x72",
    },
  ]
  let result = @verifier.verify(@parser.parse(source), source~, dependencies~)
  assert_eq(
    result is Ok(_),
    false,
    msg=match result {
      Ok(_) => "accepted"
      Err(errors) => errors[0].render()
    },
  )
}
// (component (type $expected (component (type $api (instance (export "handle" (type (sub resource))))) (import "a" (instance (type $api))) (import "b" (instance (type $api))))) (type $provided (component (type $api (instance (export "handle" (type (sub resource))))) (import "a" (instance $a (type $api))) (alias export $a "handle" (type $h)) (type $b (instance (alias outer 1 $h (type $h)) (export "handle" (type (eq $h))))) (import "b" (instance (type $b))))) (type $world (component (alias outer 1 $expected (type $expected)) (import "c" (component (type $expected))))) (type $wrapper (component (alias outer 1 $world (type $world)) (export "test:target/w" (component (type $world))))) (export "w" (type $wrapper)) (type $provider (component (alias outer 1 $provided (type $provided)) (export "test:target/provider" (component (type $provided))))) (export "provider" (type $provider)))

///|
