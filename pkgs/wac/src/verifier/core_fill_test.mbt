///|
test "core module fill empty" {
  let source = "package test:app; let a=new test:a {...}; let b=new test:b {...}; export a.out as first; export b.out as second;"
  let result = @verifier.verify(@parser.parse(source), source~, dependencies=[
    {
      name: "test:a",
      version: None,
      source: "a.wasm",
      bytes: b"\x00\x61\x73\x6d\x0d\x00\x01\x00\x03\x03\x01\x50\x00\x0a\x07\x01\x00\x01\x6d\x00\x11\x00\x0b\x0a\x01\x00\x03\x6f\x75\x74\x00\x11\x00\x00\x00\x1f\x0e\x63\x6f\x6d\x70\x6f\x6e\x65\x6e\x74\x2d\x6e\x61\x6d\x65\x01\x06\x00\x10\x01\x00\x01\x6d\x01\x06\x00\x11\x01\x00\x01\x6d",
    },
    {
      name: "test:b",
      version: None,
      source: "b.wasm",
      bytes: b"\x00\x61\x73\x6d\x0d\x00\x01\x00\x03\x03\x01\x50\x00\x0a\x07\x01\x00\x01\x6d\x00\x11\x00\x0b\x0a\x01\x00\x03\x6f\x75\x74\x00\x11\x00\x00\x00\x1f\x0e\x63\x6f\x6d\x70\x6f\x6e\x65\x6e\x74\x2d\x6e\x61\x6d\x65\x01\x06\x00\x10\x01\x00\x01\x6d\x01\x06\x00\x11\x01\x00\x01\x6d",
    },
  ])
  assert_eq(
    result is Ok(_),
    true,
    msg=match result {
      Ok(_) => "accepted"
      Err(e) => e[0].render()
    },
  )
  let model = result.unwrap()
  guard model.imports()[0].kind is Module(id) else {
    fail("missing module import")
  }
  assert_eq(model.types()[id].kind, Module({ imports: [], exports: [], }))
}

///|
test "core module fill export-width" {
  let source = "package test:app; let a=new test:a {...}; let b=new test:b {...}; export a.out as first; export b.out as second;"
  let result = @verifier.verify(@parser.parse(source), source~, dependencies=[
    {
      name: "test:a",
      version: None,
      source: "a.wasm",
      bytes: b"\x00\x61\x73\x6d\x0d\x00\x01\x00\x03\x09\x01\x50\x01\x03\x01\x78\x02\x00\x00\x0a\x07\x01\x00\x01\x6d\x00\x11\x00\x0b\x0a\x01\x00\x03\x6f\x75\x74\x00\x11\x00\x00\x00\x1f\x0e\x63\x6f\x6d\x70\x6f\x6e\x65\x6e\x74\x2d\x6e\x61\x6d\x65\x01\x06\x00\x10\x01\x00\x01\x6d\x01\x06\x00\x11\x01\x00\x01\x6d",
    },
    {
      name: "test:b",
      version: None,
      source: "b.wasm",
      bytes: b"\x00\x61\x73\x6d\x0d\x00\x01\x00\x03\x03\x01\x50\x00\x0a\x07\x01\x00\x01\x6d\x00\x11\x00\x0b\x0a\x01\x00\x03\x6f\x75\x74\x00\x11\x00\x00\x00\x1f\x0e\x63\x6f\x6d\x70\x6f\x6e\x65\x6e\x74\x2d\x6e\x61\x6d\x65\x01\x06\x00\x10\x01\x00\x01\x6d\x01\x06\x00\x11\x01\x00\x01\x6d",
    },
  ])
  assert_eq(
    result is Ok(_),
    true,
    msg=match result {
      Ok(_) => "accepted"
      Err(e) => e[0].render()
    },
  )
  let model = result.unwrap()
  guard model.imports()[0].kind is Module(id) else {
    fail("missing module import")
  }
  assert_eq(
    model.types()[id].kind,
    Module({
      imports: [],
      exports: [{ name: "x", kind: Memory(0UL, None, false, false, None), }],
    }),
  )
}

