///|
test "concrete module composition function" {
  let source = "package test:app; let a = new test:actual {}; let i = new test:expected {m: a.module}; export i as \"out\";"
  let result = @verifier.verify(@parser.parse(source), source~, dependencies=[
    {
      name: "test:actual",
      version: None,
      source: "actual.wasm",
      bytes: b"\x00\x61\x73\x6d\x0d\x00\x01\x00\x01\x2e\x00\x61\x73\x6d\x01\x00\x00\x00\x01\x06\x01\x60\x01\x7f\x01\x7f\x03\x02\x01\x00\x07\x05\x01\x01\x66\x00\x00\x0a\x06\x01\x04\x00\x20\x00\x0b\x00\x09\x04\x6e\x61\x6d\x65\x00\x02\x01\x6d\x0b\x0d\x01\x00\x06\x6d\x6f\x64\x75\x6c\x65\x00\x11\x00\x00\x00\x17\x0e\x63\x6f\x6d\x70\x6f\x6e\x65\x6e\x74\x2d\x6e\x61\x6d\x65\x01\x06\x00\x11\x01\x00\x01\x6d",
    },
    {
      name: "test:expected",
      version: None,
      source: "expected.wasm",
      bytes: b"\x00\x61\x73\x6d\x0d\x00\x01\x00\x03\x0e\x01\x50\x02\x01\x60\x01\x7f\x01\x7f\x03\x01\x66\x00\x00\x0a\x07\x01\x00\x01\x6d\x00\x11\x00\x00\x17\x0e\x63\x6f\x6d\x70\x6f\x6e\x65\x6e\x74\x2d\x6e\x61\x6d\x65\x01\x06\x00\x10\x01\x00\x01\x6d",
    },
  ])
  assert_eq(
    result is Ok(_),
    true,
    msg=match result {
      Ok(_) => "accepted"
      Err(e) => e[0].render()
    },
  )
}

