///|
test "concrete nested component empty definition and instance" {
  let result = @verifier.decode_wat_component_package(
    "(component (component $c) (instance $i (instantiate $c)) (export \"i\" (instance $i)))",
  )
  assert_true(
    result is Ok(_),
    msg=match result {
      Ok(_) => "accepted"
      Err(e) => e[0].render()
    },
  )
}

///|
test "concrete nested component minimal" {
  let result = @verifier.decode_component_package(
    b"\x00\x61\x73\x6d\x0d\x00\x01\x00\x04\xb2\x02\x00\x61\x73\x6d\x0d\x00\x01\x00\x0a\x64\x03\x00\x1c\x69\x6d\x70\x6f\x72\x74\x2d\x74\x79\x70\x65\x2d\x69\x6e\x63\x6f\x6d\x69\x6e\x67\x2d\x72\x65\x71\x75\x65\x73\x74\x03\x01\x00\x1d\x69\x6d\x70\x6f\x72\x74\x2d\x74\x79\x70\x65\x2d\x72\x65\x73\x70\x6f\x6e\x73\x65\x2d\x6f\x75\x74\x70\x61\x72\x61\x6d\x03\x01\x00\x1d\x69\x6d\x70\x6f\x72\x74\x2d\x74\x79\x70\x65\x2d\x69\x6e\x63\x6f\x6d\x69\x6e\x67\x2d\x72\x65\x71\x75\x65\x73\x74\x30\x03\x00\x00\x07\x03\x01\x69\x02\x0a\x24\x01\x00\x1e\x69\x6d\x70\x6f\x72\x74\x2d\x74\x79\x70\x65\x2d\x72\x65\x73\x70\x6f\x6e\x73\x65\x2d\x6f\x75\x74\x70\x61\x72\x61\x6d\x30\x03\x00\x01\x07\x1e\x02\x69\x04\x40\x02\x07\x72\x65\x71\x75\x65\x73\x74\x03\x0c\x72\x65\x73\x70\x6f\x6e\x73\x65\x2d\x6f\x75\x74\x05\x01\x00\x0a\x17\x01\x00\x12\x69\x6d\x70\x6f\x72\x74\x2d\x66\x75\x6e\x63\x2d\x68\x61\x6e\x64\x6c\x65\x01\x06\x0b\x2c\x02\x00\x10\x69\x6e\x63\x6f\x6d\x69\x6e\x67\x2d\x72\x65\x71\x75\x65\x73\x74\x03\x00\x00\x00\x11\x72\x65\x73\x70\x6f\x6e\x73\x65\x2d\x6f\x75\x74\x70\x61\x72\x61\x6d\x03\x01\x00\x07\x20\x03\x69\x07\x69\x08\x40\x02\x07\x72\x65\x71\x75\x65\x73\x74\x09\x0c\x72\x65\x73\x70\x6f\x6e\x73\x65\x2d\x6f\x75\x74\x0a\x01\x00\x0b\x0e\x01\x00\x06\x68\x61\x6e\x64\x6c\x65\x01\x00\x01\x01\x0b",
  )
  assert_true(
    result is Ok(_),
    msg=match result {
      Ok(_) => "accepted"
      Err(e) => e[0].render()
    },
  )
}
