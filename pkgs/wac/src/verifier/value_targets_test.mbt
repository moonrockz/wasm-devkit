///|
test "value target-value-match" {
  let source = "package test:app targets test:dep/w; let i = new test:dep {...}; export i.v;\n"
  let result = @verifier.verify(@parser.parse(source), source~, dependencies=[
    {
      name: "test:dep",
      version: None,
      source: "value-target.wasm",
      bytes: b"\x00\x61\x73\x6d\x0d\x00\x01\x00\x07\x25\x02\x41\x02\x03\x00\x01\x76\x02\x79\x04\x00\x01\x76\x02\x79\x41\x02\x02\x03\x02\x01\x00\x04\x00\x0a\x74\x65\x73\x74\x3a\x64\x65\x70\x2f\x77\x04\x00\x0b\x07\x01\x00\x01\x77\x03\x01\x00\x0a\x06\x01\x00\x01\x76\x02\x79\x0b\x07\x01\x00\x01\x76\x02\x00\x00\x00\x1f\x0e\x63\x6f\x6d\x70\x6f\x6e\x65\x6e\x74\x2d\x6e\x61\x6d\x65\x01\x0e\x03\x02\x00\x01\x77\x01\x07\x77\x72\x61\x70\x70\x65\x72",
    },
  ])
  assert_eq(
    result is Ok(_),
    true,
    msg=match result {
      Ok(_) => "accepted"
      Err(e) => e[0].render()
    },
  )
  assert_eq(source_projection(result.unwrap()), [
    "1", "v", "value", "scalar", "u32", "1", "v", "value", "scalar", "u32",
  ])
}
